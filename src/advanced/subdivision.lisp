(in-package #:sgeo.advanced)

(defun %average (points)
  (v* (/ 1d0 (length points)) (reduce #'v+ points)))

(defun %subdivision-data (positions faces)
  "Constrói incidências a partir de um instantâneo compacto do núcleo."
  (let ((edges (make-hash-table :test #'equal))
        (ordered nil)
        (incident (make-array (length positions) :initial-element nil)))
    (loop for face in faces for fi from 0 do
      (dolist (vertex face) (push fi (aref incident vertex)))
      (loop for a in face for b in (append (rest face) (list (first face)))
            for key = (sort (list a b) #'<)
            do (unless (gethash key edges) (push key ordered))
               (push fi (gethash key edges))))
    (values edges (nreverse ordered) incident)))

(defun %subdivide-once (mesh scheme)
  (multiple-value-bind (positions faces) (sgeo.geometry:mesh-polygon-data mesh)
    (when (eq scheme :loop)
      (unless (every (lambda (face) (= (length face) 3)) faces)
        (error 'validation-error :context "subdivisão Loop"
               :message "Loop exige faces triangulares; triangule uma cópia primeiro.")))
    (multiple-value-bind (edges ordered incident) (%subdivision-data positions faces)
      (let* ((face-points (map 'vector (lambda (face)
                                        (%average (mapcar (lambda (i) (aref positions i)) face))) faces))
             (output (make-array (length positions) :adjustable t :fill-pointer (length positions)))
             (edge-indices (make-hash-table :test #'equal))
             (face-indices (make-array (length faces)))
             (result nil))
        (dotimes (i (length positions))
          (let* ((point (aref positions i))
                 (keys (remove-if-not (lambda (key) (member i key)) ordered))
                 (neighbors (mapcar (lambda (key) (if (= i (first key)) (second key) (first key))) keys))
                 (boundary (loop for key in keys when (= (length (gethash key edges)) 1)
                                 collect (aref positions (if (= i (first key)) (second key) (first key)))))
                 (n (length neighbors)))
            (setf (aref output i)
                  (cond ((= (length boundary) 2)
                         (v+ (v* 0.75d0 point) (v* 0.125d0 (reduce #'v+ boundary))))
                        ((zerop n) (copy-seq point))
                        ((eq scheme :loop)
                         (let ((beta (/ (- 0.625d0 (expt (+ 0.375d0 (* 0.25d0 (cos (/ (* 2d0 pi) n)))) 2)) n)))
                           (v+ (v* (- 1d0 (* n beta)) point)
                               (v* beta (reduce #'v+ (mapcar (lambda (j) (aref positions j)) neighbors))))))
                        (t (v* (/ 1d0 n)
                               (v+ (%average (mapcar (lambda (fi) (aref face-points fi)) (aref incident i)))
                                   (v+ (v* 2d0 (%average (mapcar (lambda (j) (v* 0.5d0 (v+ point (aref positions j))))
                                                                neighbors)))
                                       (v* (- n 3) point)))))))))
        (dolist (key ordered)
          (let* ((adjacent (gethash key edges))
                 (a (aref positions (first key))) (b (aref positions (second key)))
                 (point (cond
                          ((= (length adjacent) 1) (v* 0.5d0 (v+ a b)))
                          ((eq scheme :loop)
                           (v+ (v* 0.375d0 (v+ a b))
                               (v* 0.125d0
                                   (reduce #'v+ (mapcar
                                                (lambda (fi) (aref positions (first (set-difference (nth fi faces) key))))
                                                adjacent)))))
                          (t (%average (append (list a b) (mapcar (lambda (fi) (aref face-points fi)) adjacent)))))))
            (setf (gethash key edge-indices) (vector-push-extend point output))))
        (when (eq scheme :catmull-clark)
          (dotimes (fi (length faces))
            (setf (aref face-indices fi) (vector-push-extend (aref face-points fi) output))))
        (labels ((edge-index (a b) (gethash (sort (list a b) #'<) edge-indices)))
          (loop for face in faces for fi from 0 do
            (if (eq scheme :loop)
                (destructuring-bind (a b c) face
                  (let ((ab (edge-index a b)) (bc (edge-index b c)) (ca (edge-index c a)))
                    (dolist (triangle (list (list a ab ca) (list b bc ab) (list c ca bc) (list ab bc ca)))
                      (push triangle result))))
                (loop for i below (length face) for vertex = (nth i face)
                      do (push (list vertex (edge-index vertex (nth (mod (1+ i) (length face)) face))
                                     (aref face-indices fi)
                                     (edge-index (nth (mod (1- i) (length face)) face) vertex)) result)))))
        (sgeo.geometry:make-half-edge-mesh :positions output :faces (nreverse result))))))

(defun subdivide-mesh (mesh &key (levels 1) (scheme :catmull-clark) in-place)
  "Subdivide polígonos por Catmull–Clark ou triângulos por Loop, com regras de borda."
  (unless (and (integerp levels) (<= 0 levels 8) (member scheme '(:catmull-clark :loop)))
    (error 'validation-error :context "subdivisão"
           :message "Informe zero a oito níveis e um esquema conhecido."))
  (let ((result mesh))
    (dotimes (iteration levels) (setf result (%subdivide-once result scheme)))
    (if (and in-place (plusp levels))
        (sgeo.geometry:replace-half-edge-mesh mesh result)
        (if (zerop levels)
            (multiple-value-bind (positions faces) (sgeo.geometry:mesh-polygon-data mesh)
              (sgeo.geometry:make-half-edge-mesh :positions positions :faces faces))
            result))))
