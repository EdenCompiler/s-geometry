(in-package #:sgeo.fields)

(defclass scalar-field (sgeo-object) ())
(defgeneric field-distance (field point) (:documentation "Avalia a distância assinada; interior negativo, superfície zero."))
(defgeneric field-bounds (field))
(defgeneric field-gradient (field point))
(defgeneric field-parameters (field) (:documentation "Retorna uma cópia dos parâmetros editáveis do campo."))
(defgeneric set-field-parameter (field parameter value) (:documentation "Atualiza um parâmetro do campo e avança sua revisão."))
(defmethod sgeo.core:dependencies-of ((field scalar-field)) (declare (ignore field)) nil)
(defmethod field-parameters ((field scalar-field)) (declare (ignore field)) nil)
(defmethod set-field-parameter ((field scalar-field) parameter value)
  (declare (ignore parameter value))
  (error 'sgeo.core:validation-error :context "parâmetro de campo" :message "Parâmetro não editável para este tipo de campo."))
(defun %finite-real (value label)
  (unless (and (realp value) (handler-case (= value value) (error () nil))
               (handler-case (< (abs value) most-positive-double-float) (error () nil)))
    (error 'sgeo.core:validation-error :context label :message "Esperava um número real finito."))
  (coerce value 'double-float))
(defun %copy-point (point label)
  (unless (and (typep point 'sequence) (= (length point) 3))
    (error 'sgeo.core:validation-error :context label :message "Esperava vec3."))
  (make-vec3 (%finite-real (elt point 0) label) (%finite-real (elt point 1) label) (%finite-real (elt point 2) label)))
(defmethod field-gradient ((field scalar-field) point)
  (let ((h 1d-5))
    (normalize (make-vec3
      (- (field-distance field (v+ point (make-vec3 h 0 0))) (field-distance field (v- point (make-vec3 h 0 0))))
      (- (field-distance field (v+ point (make-vec3 0 h 0))) (field-distance field (v- point (make-vec3 0 h 0))))
      (- (field-distance field (v+ point (make-vec3 0 0 h))) (field-distance field (v- point (make-vec3 0 0 h))))))))
(defun field-sample (field point) "Retorna o valor escalar do campo em um ponto vec3." (field-distance field point))
(defun %length3 (x y z) (sqrt (+ (* x x) (* y y) (* z z))))
(defun %finite-positive (x label)
  (unless (and (realp x) (> x 0) (< (abs x) most-positive-double-float))
    (error 'sgeo.core:validation-error :context label :message "Esperava um número finito positivo."))
  (coerce x 'double-float))

(defclass sphere-field (scalar-field) ((radius :initarg :radius :reader %sphere-radius)))
(defun make-sphere-field (&key (radius 1d0) (name "Campo esférico"))
  (make-instance 'sphere-field :radius (%finite-positive radius "raio") :name name))
(defmethod field-distance ((f sphere-field) p) (- (vector-length p) (%sphere-radius f)))
(defmethod field-bounds ((f sphere-field)) (let ((r (%sphere-radius f))) (make-aabb (make-vec3 (- r) (- r) (- r)) (make-vec3 r r r))))
(defmethod field-parameters ((f sphere-field)) (list :radius (%sphere-radius f)))
(defmethod set-field-parameter ((f sphere-field) (parameter (eql :radius)) value)
  (setf (slot-value f 'radius) (%finite-positive value "raio")) (touch-object f :parameter-changed) f)

(defclass box-field (scalar-field) ((half-size :initarg :half-size :reader %box-half)))
(defun make-box-field (&key (size (make-vec3 1 1 1)) (name "Campo de caixa"))
  (unless (and (typep size 'sequence) (= (length size) 3) (every (lambda (x) (> (%finite-real x "dimensão") 0d0)) size))
    (error 'sgeo.core:validation-error :context "dimensões da caixa" :message "size precisa ser vec3 positivo."))
  (make-instance 'box-field :half-size (v* (make-vec3 (elt size 0) (elt size 1) (elt size 2)) 0.5d0) :name name))
(defmethod field-distance ((f box-field) p)
  (let* ((b (%box-half f)) (qx (- (abs (vx p)) (vx b))) (qy (- (abs (vy p)) (vy b))) (qz (- (abs (vz p)) (vz b)))
         (outside (make-vec3 (max qx 0d0) (max qy 0d0) (max qz 0d0))))
    (+ (vector-length outside) (min (max qx qy qz) 0d0))))
(defmethod field-bounds ((f box-field)) (let ((b (%box-half f))) (make-aabb (v* b -1d0) b)))
(defmethod field-parameters ((f box-field)) (list :size (v* (%box-half f) 2d0)))
(defmethod set-field-parameter ((f box-field) (parameter (eql :size)) value)
  (unless (and (typep value 'sequence) (= (length value) 3) (every (lambda (x) (> (%finite-real x "dimensão") 0d0)) value))
    (error 'sgeo.core:validation-error :context "dimensões da caixa" :message "size precisa ser vec3 positivo."))
  (setf (slot-value f 'half-size) (v* (make-vec3 (elt value 0) (elt value 1) (elt value 2)) 0.5d0)) (touch-object f :parameter-changed) f)

(defclass torus-field (scalar-field) ((major :initarg :major :reader %torus-major) (minor :initarg :minor :reader %torus-minor)))
(defun make-torus-field (&key (major-radius 1d0) (minor-radius 0.25d0) (name "Campo toroidal"))
  (make-instance 'torus-field :major (%finite-positive major-radius "raio maior") :minor (%finite-positive minor-radius "raio menor") :name name))
(defmethod field-distance ((f torus-field) p)
  (- (%length3 (- (%length3 (vx p) (vy p) 0d0) (%torus-major f)) (vz p) 0d0) (%torus-minor f)))
(defmethod field-bounds ((f torus-field)) (let ((r (+ (%torus-major f) (%torus-minor f))) (z (%torus-minor f))) (make-aabb (make-vec3 (- r) (- r) (- z)) (make-vec3 r r z))))
(defmethod field-parameters ((f torus-field)) (list :major-radius (%torus-major f) :minor-radius (%torus-minor f)))
(defmethod set-field-parameter ((f torus-field) (parameter (eql :major-radius)) value) (setf (slot-value f 'major) (%finite-positive value "raio maior")) (touch-object f :parameter-changed) f)
(defmethod set-field-parameter ((f torus-field) (parameter (eql :minor-radius)) value) (setf (slot-value f 'minor) (%finite-positive value "raio menor")) (touch-object f :parameter-changed) f)

(defclass capsule-field (scalar-field) ((a :initarg :a :reader %cap-a) (b :initarg :b :reader %cap-b) (radius :initarg :radius :reader %cap-r)))
(defun make-capsule-field (&key (a (make-vec3 0 0 -0.5)) (b (make-vec3 0 0 0.5)) (radius 0.25d0) (name "Campo cápsula"))
  (make-instance 'capsule-field :a (%copy-point a "ponto A") :b (%copy-point b "ponto B") :radius (%finite-positive radius "raio") :name name))
(defmethod field-distance ((f capsule-field) p)
  (let* ((pa (v- p (%cap-a f))) (ba (v- (%cap-b f) (%cap-a f))) (den (dot ba ba))
         (h (if (<= den 1d-30) 0d0 (max 0d0 (min 1d0 (/ (dot pa ba) den))))))
    (- (vector-length (v- pa (v* ba h))) (%cap-r f))))
(defmethod field-bounds ((f capsule-field))
  (let ((r (%cap-r f)) (a (%cap-a f)) (b (%cap-b f)))
    (make-aabb (make-vec3 (- (min (vx a) (vx b)) r) (- (min (vy a) (vy b)) r) (- (min (vz a) (vz b)) r))
               (make-vec3 (+ (max (vx a) (vx b)) r) (+ (max (vy a) (vy b)) r) (+ (max (vz a) (vz b)) r)))))
(defmethod field-parameters ((f capsule-field)) (list :a (copy-seq (%cap-a f)) :b (copy-seq (%cap-b f)) :radius (%cap-r f)))
(defmethod set-field-parameter ((f capsule-field) (parameter (eql :a)) value) (setf (slot-value f 'a) (%copy-point value "ponto A")) (touch-object f :parameter-changed) f)
(defmethod set-field-parameter ((f capsule-field) (parameter (eql :b)) value) (setf (slot-value f 'b) (%copy-point value "ponto B")) (touch-object f :parameter-changed) f)
(defmethod set-field-parameter ((f capsule-field) (parameter (eql :radius)) value) (setf (slot-value f 'radius) (%finite-positive value "raio")) (touch-object f :parameter-changed) f)

(defclass plane-field (scalar-field) ((normal :initarg :normal :reader %plane-normal) (offset :initarg :offset :reader %plane-offset)))
(defun make-plane-field (&key (normal (make-vec3 0 1 0)) (offset 0d0) (name "Campo plano"))
  (let ((normal (%copy-point normal "normal do plano")))
    (when (<= (vector-length normal) 1d-15) (error 'sgeo.core:validation-error :context "normal do plano" :message "A normal precisa ser diferente de zero."))
    (make-instance 'plane-field :normal (normalize normal) :offset (%finite-real offset "deslocamento do plano") :name name)))
(defmethod field-distance ((f plane-field) p) (- (dot (%plane-normal f) p) (%plane-offset f)))
(defmethod field-bounds ((f plane-field)) nil)
(defmethod field-gradient ((f plane-field) p) (declare (ignore p)) (copy-seq (%plane-normal f)))
(defmethod field-parameters ((f plane-field)) (list :normal (copy-seq (%plane-normal f)) :offset (%plane-offset f)))
(defmethod set-field-parameter ((f plane-field) (parameter (eql :normal)) value) (let ((normal (%copy-point value "normal do plano"))) (when (<= (vector-length normal) 1d-15) (error 'sgeo.core:validation-error :context "normal do plano" :message "A normal precisa ser diferente de zero.")) (setf (slot-value f 'normal) (normalize normal))) (touch-object f :parameter-changed) f)
(defmethod set-field-parameter ((f plane-field) (parameter (eql :offset)) value) (setf (slot-value f 'offset) (%finite-real value "deslocamento do plano")) (touch-object f :parameter-changed) f)

(defclass composite-field (scalar-field) ((left :initarg :left :reader %left) (right :initarg :right :reader %right)))
(defclass union-field (composite-field) ())
(defclass intersection-field (composite-field) ())
(defclass difference-field (composite-field) ())
(defun %check-fields (a b name) (unless (and (typep a 'scalar-field) (typep b 'scalar-field)) (error 'sgeo.core:validation-error :context name :message "Os operandos precisam ser campos escalares.")))
(defun %track-field-dependencies (object fields)
  (dolist (dependency fields)
    (add-invalidation-observer dependency
      (lambda (changed reason revision)
        (declare (ignore changed reason revision))
        (touch-object object :dependency-changed))))
  object)
(defmethod sgeo.core:dependencies-of ((f composite-field)) (list (%left f) (%right f)))
(defun make-union-field (a b) (%check-fields a b "união") (%track-field-dependencies (make-instance 'union-field :left a :right b :name "União implícita") (list a b)))
(defun make-intersection-field (a b) (%check-fields a b "interseção") (%track-field-dependencies (make-instance 'intersection-field :left a :right b :name "Interseção implícita") (list a b)))
(defun make-difference-field (a b) (%check-fields a b "diferença") (%track-field-dependencies (make-instance 'difference-field :left a :right b :name "Diferença implícita") (list a b)))
(defmethod field-distance ((f union-field) p) (min (field-distance (%left f) p) (field-distance (%right f) p)))
(defmethod field-distance ((f intersection-field) p) (max (field-distance (%left f) p) (field-distance (%right f) p)))
(defmethod field-distance ((f difference-field) p) (max (field-distance (%left f) p) (- (field-distance (%right f) p))))
(defmethod field-bounds ((f union-field)) (let ((a (field-bounds (%left f))) (b (field-bounds (%right f)))) (if (and a b) (sgeo.math:aabb-union a b) nil)))
(defmethod field-bounds ((f intersection-field))
  (let ((a (field-bounds (%left f))) (b (field-bounds (%right f))))
    (cond ((null a) b) ((null b) a)
          (t (let* ((mn (make-vec3 (max (vx (aabb-min a)) (vx (aabb-min b)))
                                   (max (vy (aabb-min a)) (vy (aabb-min b)))
                                   (max (vz (aabb-min a)) (vz (aabb-min b)))))
                    (mx (make-vec3 (min (vx (aabb-max a)) (vx (aabb-max b)))
                                   (min (vy (aabb-max a)) (vy (aabb-max b)))
                                   (min (vz (aabb-max a)) (vz (aabb-max b))))))
               (when (and (<= (vx mn) (vx mx)) (<= (vy mn) (vy mx)) (<= (vz mn) (vz mx)))
                 (make-aabb mn mx)))))))
(defmethod field-bounds ((f difference-field)) (field-bounds (%left f)))

(defun smooth-union-field (a b k)
  "União pelo mínimo polinomial suavizado; k controla a largura do arredondamento." 
  (%check-fields a b "união suave") (%finite-positive k "suavização")
  (%track-field-dependencies (make-instance 'smooth-field :left a :right b :k (coerce k 'double-float) :name "União implícita suave") (list a b)))
(defclass smooth-field (composite-field) ((k :initarg :k :reader %smooth-k)))
(defmethod field-distance ((f smooth-field) p)
  (let* ((a (field-distance (%left f) p)) (b (field-distance (%right f) p)) (k (%smooth-k f))
         (h (max 0d0 (min 1d0 (+ 0.5d0 (* 0.5d0 (/ (- b a) k)))))))
    (- (lerp b a h) (* k h (- 1d0 h)))))
(defun lerp (a b fraction) (+ a (* fraction (- b a))))
(defmethod field-bounds ((f smooth-field))
  (let ((a (field-bounds (%left f))) (b (field-bounds (%right f))) (k (%smooth-k f)))
    (when (and a b) (let ((box (sgeo.math:aabb-union a b))) (make-aabb (v- (aabb-min box) (make-vec3 k k k)) (v+ (aabb-max box) (make-vec3 k k k)))))))
(defmethod field-parameters ((f smooth-field)) (list :smooth-radius (%smooth-k f)))
(defmethod set-field-parameter ((f smooth-field) (parameter (eql :smooth-radius)) value) (setf (slot-value f 'k) (%finite-positive value "suavização")) (touch-object f :parameter-changed) f)

(defclass field-transform (scalar-field) ((field :initarg :field :reader %transformed-field) (inverse :initarg :inverse :reader %field-inverse) (matrix :initarg :matrix :reader %field-matrix) (scale :initarg :scale :reader %field-scale)))
(defun %validated-transform-data (matrix)
  (unless (and (typep matrix 'sequence) (= (length matrix) 16))
    (error 'sgeo.core:validation-error :context "transformação de campo" :message "A matriz precisa conter 16 números."))
  (let* ((matrix (map 'vector (lambda (x) (%finite-real x "matriz de transformação")) matrix))
         (scales
           (loop for column below 3
                 collect (sqrt (+ (expt (aref matrix (* column 4)) 2)
                                  (expt (aref matrix (+ 1 (* column 4))) 2)
                                  (expt (aref matrix (+ 2 (* column 4))) 2)))))
         (scale (first scales))
         (c0 (make-vec3 (aref matrix 0) (aref matrix 1) (aref matrix 2)))
         (c1 (make-vec3 (aref matrix 4) (aref matrix 5) (aref matrix 6)))
         (c2 (make-vec3 (aref matrix 8) (aref matrix 9) (aref matrix 10)))
         (tol (* 1d-8 (max 1d0 scale))))
    (unless (and (> scale 1d-15)
                 (< (abs (aref matrix 3)) 1d-12) (< (abs (aref matrix 7)) 1d-12)
                 (< (abs (aref matrix 11)) 1d-12) (< (abs (- (aref matrix 15) 1d0)) 1d-12)
                 (every (lambda (x) (< (abs (- x scale)) tol)) (rest scales))
                 (< (abs (dot c0 c1)) (* tol scale))
                 (< (abs (dot c0 c2)) (* tol scale))
                 (< (abs (dot c1 c2)) (* tol scale)))
      (error 'sgeo.core:validation-error :context "transformação de campo"
             :message "A transformação precisa usar escala uniforme não nula e rotação ortogonal."))
    (values matrix (inverse-mat4 matrix) scale)))
(defun make-field-transform (field matrix)
  "Transforma um campo por mat4 rígida ou escala uniforme (distâncias exatas)."
  (unless (typep field 'scalar-field)
    (error 'sgeo.core:validation-error :context "transformação de campo" :message "Esperava scalar-field."))
  (multiple-value-bind (matrix inverse scale) (%validated-transform-data matrix)
    (%track-field-dependencies (make-instance 'field-transform :field field :matrix matrix
                                               :inverse inverse :scale scale :name "Campo transformado")
                               (list field))))
(defmethod sgeo.core:dependencies-of ((f field-transform)) (list (%transformed-field f)))
(defmethod field-parameters ((f field-transform)) (list :matrix (copy-seq (%field-matrix f))))
(defmethod set-field-parameter ((f field-transform) (parameter (eql :matrix)) value)
  (multiple-value-bind (matrix inverse scale) (%validated-transform-data value)
    (setf (slot-value f 'matrix) matrix (slot-value f 'inverse) inverse (slot-value f 'scale) scale))
  (touch-object f :parameter-changed) f)
(defmethod field-distance ((f field-transform) p) (* (%field-scale f) (field-distance (%transformed-field f) (transform-point (%field-inverse f) p))))
(defmethod field-bounds ((f field-transform)) (let ((b (field-bounds (%transformed-field f)))) (when b (transform-aabb b (%field-matrix f)))))
(defmethod field-gradient ((f field-transform) p) (normalize (sgeo.math:transform-direction (inverse-mat4 (%field-inverse f)) (field-gradient (%transformed-field f) (transform-point (%field-inverse f) p)))))

(defun %grid-dimensions (resolution)
  (let ((r (if (integerp resolution) (vector resolution resolution resolution) resolution)))
    (unless (and (typep r 'array) (= (length r) 3) (every (lambda (x) (and (integerp x) (>= x 2))) r))
      (error 'sgeo.core:validation-error :context "resolução do campo" :message "A resolução precisa ser inteiro >= 2 ou vec3 de inteiros >= 2.")) r))
(defun sample-field-grid (field bounds resolution)
  "Amostra o campo em grade regular. Retorna dimensões e vetor plano x-major."
  (let* ((dims (%grid-dimensions resolution))
         (nx (vx dims)) (ny (vy dims)) (nz (vz dims))
         (mn (aabb-min bounds)) (mx (aabb-max bounds))
         (samples (make-array (* nx ny nz) :element-type 'double-float)))
    (dotimes (k nz)
      (dotimes (j ny)
        (dotimes (i nx)
          (let ((point (make-vec3
                        (+ (vx mn) (* (/ i (1- nx)) (- (vx mx) (vx mn))))
                        (+ (vy mn) (* (/ j (1- ny)) (- (vy mx) (vy mn))))
                        (+ (vz mn) (* (/ k (1- nz)) (- (vz mx) (vz mn)))))))
            (setf (aref samples (%node-id i j k nx ny))
                  (field-distance field point))))))
    (values dims samples)))
(defun %grid-point (i j k dims mn mx)
  (make-vec3 (+ (vx mn) (* (/ i (1- (vx dims))) (- (vx mx) (vx mn)))) (+ (vy mn) (* (/ j (1- (vy dims))) (- (vy mx) (vy mn)))) (+ (vz mn) (* (/ k (1- (vz dims))) (- (vz mx) (vz mn))))))
(defun %node-id (i j k nx ny) (+ i (* nx (+ j (* ny k)))))
(defun %tetrahedra () '((0 1 2 6) (0 2 3 6) (0 3 7 6) (0 7 4 6) (0 4 5 6) (0 5 1 6)))
(defun %sort-polygon (points normal)
  (let* ((center (reduce #'v+ points :initial-value (make-vec3))) (n (length points)))
    (setf center (v* center (/ 1d0 n)))
    (let* ((u (normalize (if (> (abs (vx normal)) 0.8d0) (cross normal (make-vec3 0 1 0)) (cross normal (make-vec3 1 0 0)))))
           (v (cross normal u)))
      (stable-sort points #'< :key (lambda (p) (let ((d (v- p center))) (atan (dot d v) (dot d u))))))))
(defun field->mesh (field &key bounds (resolution 32) (name "Malha implícita"))
  "Extrai a superfície zero por decomposição tetraédrica consistente e retorna malha editável."
  (unless (typep field 'scalar-field)
    (error 'sgeo.core:validation-error :context "malhagem implícita" :message "Esperava scalar-field."))
  (let* ((bounds (or bounds (field-bounds field)))
         (dims (%grid-dimensions resolution)))
    (unless bounds
      (error 'sgeo.core:validation-error :context "malhagem implícita" :message "Campo sem limites; forneça :bounds."))
    (multiple-value-bind (dims samples) (sample-field-grid field bounds dims)
      (let* ((nx (vx dims)) (ny (vy dims)) (nz (vz dims))
             (mn (aabb-min bounds)) (mx (aabb-max bounds))
             (vertices (make-array 0 :adjustable t :fill-pointer 0))
             (faces nil) (edge-cache (make-hash-table :test #'equal)))
        (labels ((grid-point (i j k) (%grid-point i j k dims mn mx))
                 (sample (i j k)
                   (let ((value (aref samples (%node-id i j k nx ny))))
                     ;; Viés sub-voxel determinístico: evita vértices exatamente duplicados no nível zero.
                     (if (<= (abs value) 1d-14) 1d-14 value)))
                 (edge-vertex (id-a point-a value-a id-b point-b value-b)
                   (let* ((key (if (< id-a id-b) (list id-a id-b) (list id-b id-a)))
                          (cached (gethash key edge-cache)))
                     (if cached cached
                         (let* ((fraction (max 0d0 (min 1d0 (/ value-a (- value-a value-b)))))
                                (point (v+ point-a (v* (v- point-b point-a) fraction)))
                                (index (length vertices)))
                           (vector-push-extend point vertices)
                           (setf (gethash key edge-cache) index)
                           index))))
                 (polygon-indices (crossings normal)
                   (let* ((points (mapcar (lambda (entry) (aref vertices (cdr entry))) crossings))
                          (ordered-points (%sort-polygon points normal))
                          (ordered-indices
                            (mapcar (lambda (point)
                                      (cdr (find point crossings
                                                 :key (lambda (entry) (aref vertices (cdr entry)))
                                                 :test #'eq)))
                                    ordered-points)))
                     (when (< (dot (cross (v- (aref vertices (second ordered-indices))
                                                (aref vertices (first ordered-indices)))
                                            (v- (aref vertices (third ordered-indices))
                                                (aref vertices (first ordered-indices)))) normal) 0d0)
                       (setf ordered-indices (reverse ordered-indices)))
                     ordered-indices)))
          (loop for k below (1- nz) do
            (loop for j below (1- ny) do
              (loop for i below (1- nx)
                    for coords = (list (list i j k) (list (1+ i) j k)
                                       (list (1+ i) (1+ j) k) (list i (1+ j) k)
                                       (list i j (1+ k)) (list (1+ i) j (1+ k))
                                       (list (1+ i) (1+ j) (1+ k)) (list i (1+ j) (1+ k)))
                    for ids = (mapcar (lambda (c) (apply #'%node-id (append c (list nx ny)))) coords)
                    for points = (mapcar (lambda (c) (apply #'grid-point c)) coords)
                    for values = (mapcar (lambda (c) (apply #'sample c)) coords)
                    do (dolist (tet (%tetrahedra))
                         (let ((crossings nil))
                           (dolist (a tet)
                             (dolist (b tet)
                               (when (< a b)
                                 (let ((va (nth a values)) (vb (nth b values)))
                                   (unless (eq (< va 0d0) (< vb 0d0))
                                     (push (cons (list (min (nth a ids) (nth b ids))
                                                       (max (nth a ids) (nth b ids)))
                                                 (edge-vertex (nth a ids) (nth a points) va
                                                              (nth b ids) (nth b points) vb))
                                           crossings))))))
                           (setf crossings (remove-duplicates crossings :key #'cdr))
                           (when (>= (length crossings) 3)
                             (let* ((center (v* (reduce #'v+ (mapcar (lambda (entry) (aref vertices (cdr entry))) crossings))
                                                (/ 1d0 (length crossings))))
                                    (normal (field-gradient field center))
                                    (indices (polygon-indices crossings normal)))
                               (loop for n from 1 below (1- (length indices))
                                     do (push (list (first indices) (nth n indices) (nth (1+ n) indices)) faces)))))))))
        (unless faces
          (error 'sgeo.core:validation-error :context "malhagem implícita" :message "A grade não cruzou a superfície zero."))
        (let ((mesh (make-half-edge-mesh :positions vertices :faces (nreverse faces) :name name)))
          (validate-mesh mesh)
          mesh))))))
