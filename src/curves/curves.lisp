(in-package #:sgeo.curves)

(defun %vec3-copy (p)
  (unless (and (typep p 'sequence) (= (length p) 3)
               (every (lambda (x) (and (realp x) (handler-case (< (abs x) most-positive-double-float) (error () nil)))) p))
    (error 'sgeo.core:validation-error :context "curva" :message "Controle precisa ser vec3."))
  (make-vec3 (elt p 0) (elt p 1) (elt p 2)))
(defun %vec2-copy (point)
  (unless (and (typep point 'sequence) (= (length point) 2)
               (every (lambda (x) (and (realp x) (handler-case (< (abs x) most-positive-double-float) (error () nil)))) point))
    (error 'sgeo.core:validation-error :context "perfil" :message "Cada ponto de perfil precisa conter dois números."))
  (make-vec2 (elt point 0) (elt point 1)))
(defun %controls (points minimum)
  (let ((out (map 'vector #'%vec3-copy points))) (when (< (length out) minimum) (error 'sgeo.core:validation-error :context "curva" :message "Quantidade insuficiente de pontos de controle.")) out))
(defclass curve (sgeo-object) ())
(defgeneric curve-control-points (curve))
(defgeneric set-curve-control-point (curve index point))
(defgeneric curve-point (curve parameter))
(defgeneric curve-derivative (curve parameter))
(defun curve-tangent (curve parameter)
  (let ((derivative (curve-derivative curve parameter)))
    (when (<= (vector-length derivative) 1d-12)
      (error 'sgeo.core:validation-error :context "tangente" :message "A derivada é nula neste parâmetro."))
    (normalize derivative)))
(defun curve-sample (curve count)
  "Amostra count pontos incluindo as duas extremidades do domínio [0,1]."
  (unless (and (integerp count) (>= count 2)) (error 'sgeo.core:validation-error :context "amostragem de curva" :message "count precisa ser inteiro >= 2."))
  (loop for i below count collect (curve-point curve (/ i (1- count)))))

(defclass polyline-curve (curve) ((control-points :initarg :control-points :accessor %polyline-controls)))
(defun make-polyline-curve (control-points &key (name "Polilinha"))
  "Cria uma curva linear por segmentos com parâmetro normalizado em [0,1]."
  (make-instance 'polyline-curve :control-points (%controls control-points 2) :name name))
(defmethod curve-control-points ((c polyline-curve)) (map 'vector #'copy-seq (%polyline-controls c)))
(defmethod set-curve-control-point ((c polyline-curve) index point)
  (unless (and (integerp index) (<= 0 index) (< index (length (%polyline-controls c))))
    (error 'sgeo.core:validation-error :context "ponto de controle" :message "Índice fora do intervalo."))
  (setf (aref (%polyline-controls c) index) (%vec3-copy point))
  (sgeo.core:touch-object c :control-point-changed)
  c)
(defmethod curve-point ((c polyline-curve) parameter)
  (let* ((u (%check-parameter parameter "polilinha")) (points (%polyline-controls c))
         (scaled (* u (1- (length points)))) (i (min (floor scaled) (- (length points) 2)))
         (fraction (if (= u 1d0) 1d0 (- scaled i))))
    (v+ (v* (aref points i) (- 1d0 fraction)) (v* (aref points (1+ i)) fraction))))
(defmethod curve-derivative ((c polyline-curve) parameter)
  (let* ((u (%check-parameter parameter "derivada da polilinha")) (points (%polyline-controls c))
         (i (min (floor (* u (1- (length points)))) (- (length points) 2))))
    (v* (v- (aref points (1+ i)) (aref points i)) (1- (length points)))))

(defclass bezier-curve (curve) ((control-points :initarg :control-points :accessor %bezier-controls)))
(defun make-bezier-curve (control-points &key (name "Curva Bézier")) (make-instance 'bezier-curve :control-points (%controls control-points 2) :name name))
(defmethod curve-control-points ((c bezier-curve)) (map 'vector #'copy-seq (%bezier-controls c)))
(defmethod set-curve-control-point ((c bezier-curve) index point)
  (unless (and (integerp index) (<= 0 index) (< index (length (%bezier-controls c))))
    (error 'sgeo.core:validation-error :context "ponto de controle" :message "Índice fora do intervalo."))
  (setf (aref (%bezier-controls c) index) (%vec3-copy point))
  (sgeo.core:touch-object c :control-point-changed)
  c)
(defun %de-casteljau (points tval)
  (let ((work (map 'vector #'copy-seq points)))
    (loop for width from (length work) downto 2 do
      (dotimes (i (1- width)) (setf (aref work i) (v+ (v* (aref work i) (- 1d0 tval)) (v* (aref work (1+ i)) tval)))))
    (aref work 0)))
(defun %check-parameter (u context)
  (unless (and (realp u) (handler-case (< (abs u) most-positive-double-float) (error () nil)) (<= 0d0 u 1d0)) (error 'sgeo.core:validation-error :context context :message "O parâmetro precisa ser finito e estar em [0,1].")) (coerce u 'double-float))
(defmethod curve-point ((c bezier-curve) u) (%de-casteljau (%bezier-controls c) (%check-parameter u "Bézier")))
(defmethod curve-derivative ((c bezier-curve) u)
  (let* ((pts (%bezier-controls c)) (n (1- (length pts))) (deriv (make-array n)))
    (dotimes (i n) (setf (aref deriv i) (v* (v- (aref pts (1+ i)) (aref pts i)) n)))
    (%de-casteljau deriv (%check-parameter u "derivada Bézier"))))

(defclass bspline-curve (curve) ((control-points :initarg :control-points :reader %bs-controls) (degree :initarg :degree :reader bspline-degree) (knots :initarg :knots :reader bspline-knots)))
(defun make-bspline-curve (control-points &key (degree 3) knots (name "Curva B-spline"))
  (unless (and (integerp degree) (>= degree 1))
    (error 'sgeo.core:validation-error :context "B-spline" :message "O grau precisa ser inteiro positivo."))
  (let* ((points (%controls control-points (1+ degree)))
         (count (length points))
         (knot-vector
           (if knots
               (map 'vector (lambda (x)
                              (unless (and (realp x) (handler-case (< (abs x) most-positive-double-float) (error () nil)))
                                (error 'sgeo.core:validation-error :context "B-spline" :message "O vetor de nós precisa conter números finitos."))
                              (coerce x 'double-float))
                    knots)
               (coerce
                (append (make-list (1+ degree) :initial-element 0d0)
                        (loop for i from 1 below (- count degree) collect (/ i (- count degree)))
                        (make-list (1+ degree) :initial-element 1d0))
                'vector))))
    (unless (and (< degree count)
                 (= (length knot-vector) (+ count degree 1))
                 (loop for i from 1 below (length knot-vector)
                       always (<= (aref knot-vector (1- i)) (aref knot-vector i)))
                 (< (aref knot-vector degree) (aref knot-vector count)))
      (error 'sgeo.core:validation-error :context "B-spline" :message "Grau ou vetor de nós inválido."))
    (make-instance 'bspline-curve :control-points points :degree degree
                   :knots knot-vector
                   :name name)))
(defmethod curve-control-points ((c bspline-curve)) (map 'vector #'copy-seq (%bs-controls c)))
(defmethod set-curve-control-point ((c bspline-curve) index point)
  (unless (and (integerp index) (<= 0 index) (< index (length (%bs-controls c))))
    (error 'sgeo.core:validation-error :context "ponto de controle" :message "Índice fora do intervalo."))
  (setf (aref (%bs-controls c) index) (%vec3-copy point))
  (sgeo.core:touch-object c :control-point-changed)
  c)
(defun %find-span (n p u knots)
  (cond ((>= u (aref knots (1+ n))) n) ((<= u (aref knots p)) p)
        (t (loop with low = p with high = (1+ n) for mid = (floor (+ low high) 2)
                 when (and (>= u (aref knots mid)) (< u (aref knots (1+ mid)))) return mid
                 do (if (< u (aref knots mid)) (setf high mid) (setf low mid))))))
(defun %de-boor (points degree knots u)
  "Avalia uma curva B-spline por recorrência Cox-de Boor dos pesos de base."
  (let* ((count (length points))
         (domain-end (aref knots count))
         (basis (make-array (1- (length knots)) :initial-element 0d0)))
    (dotimes (i (length basis))
      (when (or (and (<= (aref knots i) u) (< u (aref knots (1+ i))))
                (and (= u domain-end) (= i (1- count))))
        (setf (aref basis i) 1d0)))
    (loop for current-degree from 1 to degree do
      (let ((next (make-array (1- (length basis)) :initial-element 0d0)))
        (dotimes (i (length next))
          (let* ((left-den (- (aref knots (+ i current-degree)) (aref knots i)))
                 (right-den (- (aref knots (+ i current-degree 1)) (aref knots (1+ i))))
                 (left (if (zerop left-den) 0d0 (* (/ (- u (aref knots i)) left-den) (aref basis i))))
                 (right (if (zerop right-den) 0d0 (* (/ (- (aref knots (+ i current-degree 1)) u) right-den) (aref basis (1+ i))))))
            (setf (aref next i) (+ left right))))
        (setf basis next)))
    (loop with result = (make-vec3)
          for i below count
          do (setf result (v+ result (v* (aref points i) (aref basis i))))
          finally (return result))))
(defmethod curve-point ((c bspline-curve) u) (%de-boor (%bs-controls c) (bspline-degree c) (bspline-knots c) (%check-parameter u "B-spline")))
(defmethod curve-derivative ((c bspline-curve) u)
  (let* ((p (bspline-degree c)) (pts (%bs-controls c)) (knots (bspline-knots c)) (deriv (make-array (1- (length pts)))))
    (dotimes (i (length deriv)) (let ((den (- (aref knots (+ i p 1)) (aref knots (1+ i)))))
      (setf (aref deriv i) (if (zerop den) (make-vec3) (v* (v- (aref pts (1+ i)) (aref pts i)) (/ p den))))))
    (%de-boor deriv (1- p) (subseq knots 1 (1- (length knots))) (%check-parameter u "derivada B-spline"))))

(defclass surface (sgeo-object) ())
(defgeneric surface-point (surface u v))
(defgeneric surface-derivatives (surface u v))
(defclass parametric-surface (surface) ((function :initarg :function :reader %surface-function)))
(defun make-parametric-surface (function &key (name "Superfície paramétrica"))
  (unless (functionp function) (error 'sgeo.core:validation-error :context "superfície" :message "Esperava função de dois parâmetros."))
  (make-instance 'parametric-surface :function function :name name))
(defmethod surface-point ((s parametric-surface) u v) (%vec3-copy (funcall (%surface-function s) (%check-parameter u "superfície u") (%check-parameter v "superfície v"))))
(defmethod surface-derivatives ((s parametric-surface) u v)
  (let ((h 1d-5) (u (%check-parameter u "superfície u")) (v (%check-parameter v "superfície v")))
    (values (v* (v- (surface-point s (min 1d0 (+ u h)) v) (surface-point s (max 0d0 (- u h)) v)) (/ 1d0 (+ (min 1d0 (+ u h)) (- (max 0d0 (- u h))))))
            (v* (v- (surface-point s u (min 1d0 (+ v h))) (surface-point s u (max 0d0 (- v h)))) (/ 1d0 (+ (min 1d0 (+ v h)) (- (max 0d0 (- v h)))))))))
(defclass bezier-surface (surface) ((controls :initarg :controls :reader %surface-controls)))
(defgeneric surface-control-grid (surface))
(defgeneric set-surface-control-point (surface row column point))
(defun make-bezier-surface (control-grid &key (name "Superfície Bézier"))
  (unless (and (typep control-grid 'array) (= (array-rank control-grid) 2) (>= (array-dimension control-grid 0) 2) (>= (array-dimension control-grid 1) 2))
    (error 'sgeo.core:validation-error :context "superfície Bézier" :message "A grade de controle precisa ser array 2D com ao menos 2x2 pontos."))
  (let ((out (make-array (array-dimensions control-grid))))
    (dotimes (i (array-dimension out 0)) (dotimes (j (array-dimension out 1)) (setf (aref out i j) (%vec3-copy (aref control-grid i j)))))
    (make-instance 'bezier-surface :controls out :name name)))
(defmethod surface-control-grid ((s bezier-surface))
  (let* ((controls (%surface-controls s)) (out (make-array (array-dimensions controls))))
    (dotimes (i (array-dimension out 0)) (dotimes (j (array-dimension out 1)) (setf (aref out i j) (copy-seq (aref controls i j)))))
    out))
(defmethod set-surface-control-point ((s bezier-surface) row column point)
  (let ((controls (%surface-controls s)))
    (unless (and (integerp row) (<= 0 row) (< row (array-dimension controls 0))
                 (integerp column) (<= 0 column) (< column (array-dimension controls 1)))
      (error 'sgeo.core:validation-error :context "controle de superfície" :message "Índice fora da grade."))
    (setf (aref controls row column) (%vec3-copy point))
    (sgeo.core:touch-object s :control-point-changed)
    s))
(defmethod surface-point ((s bezier-surface) u v)
  (let* ((grid (%surface-controls s)) (u (%check-parameter u "Bézier u")) (v (%check-parameter v "Bézier v"))
         (rows (make-array (array-dimension grid 0))))
    (dotimes (i (length rows)) (setf (aref rows i) (%de-casteljau (make-array (array-dimension grid 1) :initial-contents (loop for j below (array-dimension grid 1) collect (aref grid i j))) v)))
    (%de-casteljau rows u)))
(defmethod surface-derivatives ((s bezier-surface) u v)
  (let* ((h 1d-5) (u (%check-parameter u "Bézier u")) (v (%check-parameter v "Bézier v"))) (values (v* (v- (surface-point s (min 1d0 (+ u h)) v) (surface-point s (max 0d0 (- u h)) v)) (/ 1d0 (+ (min 1d0 (+ u h)) (- (max 0d0 (- u h))))))
                          (v* (v- (surface-point s u (min 1d0 (+ v h))) (surface-point s u (max 0d0 (- v h)))) (/ 1d0 (+ (min 1d0 (+ v h)) (- (max 0d0 (- v h)))))))))

(defun tessellate-surface (s &key (u-segments 16) (v-segments 16) (name "Superfície tessellada"))
  "Tessela a superfície em quadriláteros e retorna uma malha half-edge editável."
  (unless (and (integerp u-segments) (>= u-segments 1) (integerp v-segments) (>= v-segments 1)) (error 'sgeo.core:validation-error :context "tesselação" :message "Segmentos precisam ser inteiros positivos."))
  (let ((positions (make-array 0 :adjustable t :fill-pointer 0)) (faces nil) (nu (1+ u-segments)) (nv (1+ v-segments)))
    (dotimes (i nu) (dotimes (j nv) (let ((p (surface-point s (/ i u-segments) (/ j v-segments)))) (vector-push-extend p positions))))
    (flet ((idx (i j) (+ (* i nv) j)))
      (dotimes (i u-segments) (dotimes (j v-segments) (let ((a (idx i j)) (b (idx (1+ i) j)) (c (idx (1+ i) (1+ j))) (d (idx i (1+ j)))) (push (list a b c d) faces)))))
    (make-half-edge-mesh :positions positions :faces (nreverse faces) :name name)))

(defun %initial-frame (tangent)
  (let* ((reference (if (> (abs (vz tangent)) 0.9d0) (make-vec3 0 1 0) (make-vec3 0 0 1)))
         (normal (normalize (cross reference tangent)))) (values normal (normalize (cross tangent normal)))))
(defun %sweep-profile (profile)
  (unless (typep profile 'sequence)
    (error 'sgeo.core:validation-error :context "perfil de varredura" :message "O perfil precisa ser uma sequência de vec2."))
  (let* ((points (map 'vector #'%vec2-copy profile))
         (count (length points)))
    (when (and (> count 3) (< (vector-length (make-vec3 (- (vx (aref points 0)) (vx (aref points (1- count))))
                                                         (- (vy (aref points 0)) (vy (aref points (1- count)))) 0d0)) 1d-12))
      (setf points (subseq points 0 (1- count)) count (1- count)))
    (when (< count 3)
      (error 'sgeo.core:validation-error :context "perfil de varredura" :message "O perfil precisa de três pontos distintos."))
    (let ((area 0d0))
      (dotimes (i count)
        (let* ((a (aref points i)) (b (aref points (mod (1+ i) count)))
               (dx (- (vx b) (vx a))) (dy (- (vy b) (vy a))))
          (when (< (sqrt (+ (* dx dx) (* dy dy))) 1d-12)
            (error 'sgeo.core:validation-error :context "perfil de varredura" :message "O perfil não pode ter arestas de comprimento zero."))
          (incf area (- (* (vx a) (vy b)) (* (vy a) (vx b))))))
      (when (< (abs area) 1d-12)
        (error 'sgeo.core:validation-error :context "perfil de varredura" :message "O perfil não pode ter área nula.")))
    points))
(defun sweep-curve (path profile &key (path-segments 32) (name "Varredura"))
  "Varre perfil fechado de vec2 ao longo de uma curva usando quadro transportado." 
  (unless (and (typep path 'curve) (typep profile 'sequence) (>= (length profile) 3) (integerp path-segments) (>= path-segments 1)) (error 'sgeo.core:validation-error :context "varredura" :message "Esperava curva, perfil com 3+ pontos e segmentos positivos."))
  (let* ((profile (%sweep-profile profile)) (ring-count (1+ path-segments)) (m (length profile)) (positions (make-array (* ring-count m))) (faces nil) (previous-normal nil) (frames (make-array ring-count)))
    (dotimes (i ring-count)
      (let* ((u (/ i path-segments)) (center (curve-point path u)) (tangent (curve-tangent path u)) (normal (if previous-normal (let ((projected (v- previous-normal (v* tangent (dot previous-normal tangent))))) (if (> (vector-length projected) 1d-10) (normalize projected) (nth-value 0 (%initial-frame tangent)))) (nth-value 0 (%initial-frame tangent)))) (binormal (normalize (cross tangent normal))))
        (setf previous-normal normal (aref frames i) (list center tangent normal binormal u))))
    ;; Curvas fechadas com tangentes coincidentes recebem correção de torção distribuída até a emenda.
    (let* ((first-frame (aref frames 0)) (last-frame (aref frames (1- ring-count)))
           (closed-p (and (< (vector-length (v- (first first-frame) (first last-frame))) 1d-8)
                          (> (dot (second first-frame) (second last-frame)) 0.999d0)))
           (twist (if closed-p
                      (atan (dot (second first-frame) (cross (third last-frame) (third first-frame)))
                            (dot (third last-frame) (third first-frame)))
                      0d0)))
      (dotimes (i ring-count)
        (destructuring-bind (center tangent normal binormal u) (aref frames i)
          (let* ((angle (* twist u))
                 (adjusted-normal (v+ (v* normal (cos angle)) (v* binormal (sin angle))))
                 (adjusted-binormal (cross tangent adjusted-normal)))
            (dotimes (j m) (let ((q (elt profile j))) (setf (aref positions (+ (* i m) j)) (v+ center (v+ (v* adjusted-normal (vx q)) (v* adjusted-binormal (vy q))))))))))
    (dotimes (i path-segments) (dotimes (j m) (let ((a (+ (* i m) j)) (b (+ (* i m) (mod (1+ j) m))) (c (+ (* (1+ i) m) (mod (1+ j) m))) (d (+ (* (1+ i) m) j))) (push (list a b c d) faces))))
    (make-half-edge-mesh :positions positions :faces (nreverse faces) :name name))))

(defun lathe-surface (profile &key (segments 32) (name "Superfície torneada"))
  "Gira um perfil (raio,z) em torno do eixo Z e cria malha half-edge editável." 
  (unless (and (typep profile 'sequence) (>= (length profile) 2) (integerp segments) (>= segments 3)
               (every (lambda (p) (handler-case (and (>= (vx (%vec2-copy p)) 0) t) (error () nil))) profile))
    (error 'sgeo.core:validation-error :context "torneamento" :message "Perfil precisa de 2+ pares (raio,z), raio >= 0, e 3+ segmentos."))
  (let* ((profile (map 'vector #'%vec2-copy profile))
         (rows (length profile)) (positions (make-array (* segments rows))) (faces nil))
    (dotimes (i segments) (let ((angle (* 2d0 pi (/ i segments)))) (dotimes (j rows) (let ((r (vx (elt profile j))) (z (vy (elt profile j)))) (setf (aref positions (+ (* i rows) j)) (make-vec3 (* r (cos angle)) (* r (sin angle)) z))))))
    (dotimes (i segments) (dotimes (j (1- rows))
      (let* ((a (+ (* i rows) j)) (b (+ (* (mod (1+ i) segments) rows) j)) (c (1+ b)) (d (1+ a)) (ra (vx (elt profile j))) (rb (vx (elt profile (1+ j)))))
        (cond ((and (zerop ra) (zerop rb))) ((zerop ra) (push (list a c d) faces)) ((zerop rb) (push (list a b c) faces)) (t (push (list a b c d) faces))))))
    ;; A soldagem dos anéis nos polos evita arestas degeneradas e mantém topologia manifold.
    (let ((coords (make-hash-table :test #'equal)) (welded (make-array 0 :adjustable t :fill-pointer 0)) (mapping (make-array (length positions))) (wfaces nil))
      (dotimes (i (length positions)) (let* ((p (aref positions i)) (key (list (round (* (vx p) 1d10)) (round (* (vy p) 1d10)) (round (* (vz p) 1d10)))) (idx (gethash key coords)))
        (unless idx (setf idx (floor (length welded) 1) (gethash key coords) idx) (vector-push-extend p welded)) (setf (aref mapping i) idx)))
      (dolist (face (nreverse faces)) (let ((mapped (mapcar (lambda (i) (aref mapping i)) face)))
        (when (and (member (length mapped) '(3 4)) (= (length mapped) (length (remove-duplicates mapped))) (> (length mapped) 2))
          (push mapped wfaces))))
      (make-half-edge-mesh :positions welded :faces (nreverse wfaces) :name name))))
