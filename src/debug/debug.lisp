(defun %glyph-rows (character)
  (or (rest (assoc (char-upcase character) *bitmap-font-5x7* :test #'char=))
      (rest (assoc #\? *bitmap-font-5x7* :test #'char=))))

(defun %camera-basis (world)
  (let* ((camera (sgeo.scene:world-camera world))
         (forward (sgeo.math:normalize
                   (sgeo.math:v- (sgeo.scene:camera-target camera)
                                 (sgeo.scene:camera-eye camera))))
         (given-up (sgeo.scene:camera-up camera))
         (right (sgeo.math:cross forward given-up)))
    (when (< (sgeo.math:vector-length right) 1d-12)
      (setf right (sgeo.math:cross forward #(0d0 0d0 1d0)))
      (when (< (sgeo.math:vector-length right) 1d-12)
        (setf right (sgeo.math:cross forward #(1d0 0d0 0d0)))))
    (setf right (sgeo.math:normalize right))
    (values forward right (sgeo.math:normalize (sgeo.math:cross right forward)))))

(defun %builder-for (builders color)
  (or (gethash color builders)
      (setf (gethash (copy-seq color) builders) (%make-mesh-builder))))

(defun %append-quad (builder a b c d)
  (let ((base (mesh-builder-vertex-count builder)))
    (dolist (point (list a b c d))
      (loop for component across point
            do (push component (mesh-builder-positions builder))))
    (dolist (index (list base (+ base 2) (+ base 1)
                         base (+ base 3) (+ base 2)))
      (push index (mesh-builder-indices builder)))
    (incf (mesh-builder-vertex-count builder) 4)))

(defun %line-quad (a b width camera-forward camera-right)
  (let* ((direction (sgeo.math:v- b a))
         (length (sgeo.math:vector-length direction)))
    (when (> length 1d-12)
      (let* ((unit (sgeo.math:v* direction (/ 1d0 length)))
             (offset-direction (sgeo.math:cross unit camera-forward)))
        (when (< (sgeo.math:vector-length offset-direction) 1d-12)
          (setf offset-direction camera-right))
        (let ((offset (sgeo.math:v* (sgeo.math:normalize offset-direction) (/ width 2d0))))
          (list (sgeo.math:v+ a offset) (sgeo.math:v+ b offset)
                (sgeo.math:v- b offset) (sgeo.math:v- a offset)))))))

(defun %add-line (builders command a b forward right)
  (let ((quad (%line-quad a b (debug-command-width command) forward right)))
    (when quad (%append-quad (%builder-for builders (debug-command-color command))
                             (first quad) (second quad) (third quad) (fourth quad)))))

(defun %sphere-lines (command builders forward right)
  (let* ((center (getf (debug-command-data command) :center))
         (radius (getf (debug-command-data command) :radius))
         (segments 32))
    (dolist (plane '((0 1) (0 2) (1 2)))
      (loop for index below segments
            for angle = (* 2d0 pi (/ index segments))
            for next-angle = (* 2d0 pi (/ (1+ index) segments))
            for from = (copy-seq center)
            for to = (copy-seq center)
            do (setf (aref from (first plane)) (+ (aref center (first plane))
                                                   (* radius (cos angle)))
                     (aref from (second plane)) (+ (aref center (second plane))
                                                    (* radius (sin angle)))
                     (aref to (first plane)) (+ (aref center (first plane))
                                                 (* radius (cos next-angle)))
                     (aref to (second plane)) (+ (aref center (second plane))
                                                  (* radius (sin next-angle))))
               (%add-line builders command from to forward right)))))

(defun %aabb-lines (command builders forward right)
  (let* ((minimum (getf (debug-command-data command) :minimum))
         (maximum (getf (debug-command-data command) :maximum))
         (corners (loop for mask below 8
                        collect (vector (if (logbitp 0 mask) (aref maximum 0) (aref minimum 0))
                                        (if (logbitp 1 mask) (aref maximum 1) (aref minimum 1))
                                        (if (logbitp 2 mask) (aref maximum 2) (aref minimum 2))))))
    (loop for index below 8 do
      (loop for bit in '(1 2 4) when (zerop (logand index bit)) do
        (%add-line builders command (nth index corners)
                   (nth (logior index bit) corners) forward right)))))

(defun %text-geometry (command builders right up)
  (let* ((data (debug-command-data command))
         (origin (getf data :position))
         (text (getf data :text))
         (cell (/ (getf data :height) 7d0))
         (builder (%builder-for builders (debug-command-color command))))
    (loop for character across text
          for glyph-index from 0
          for rows = (%glyph-rows character)
          do (loop for row in rows for y from 0 do
               (loop for x below 5
                     when (char= (char row x) #\1) do
                       (let* ((base (sgeo.math:v+
                                     origin
                                     (sgeo.math:v+
                                      (sgeo.math:v* right (* cell (+ (* glyph-index 6) x)))
                                      (sgeo.math:v* up (* cell (- 6 y))))))
                              (next (sgeo.math:v+ base (sgeo.math:v* right cell)))
                              (top-next (sgeo.math:v+ next (sgeo.math:v* up cell)))
                              (top (sgeo.math:v+ base (sgeo.math:v* up cell))))
                         (%append-quad builder base next top-next top)))))))

(defun %collect-geometry (world commands)
  (multiple-value-bind (forward right up) (%camera-basis world)
    (let ((builders (make-hash-table :test #'equalp)))
      (dolist (command commands)
        (case (debug-command-kind command)
          (:line
           (%add-line builders command (getf (debug-command-data command) :a)
                      (getf (debug-command-data command) :b) forward right))
          (:aabb (%aabb-lines command builders forward right))
          (:sphere (%sphere-lines command builders forward right))
          (:text (%text-geometry command builders right up))))
      (let ((result nil))
        (maphash (lambda (color builder)
                   (when (mesh-builder-indices builder)
                     (push (list color
                                 (coerce (nreverse (mesh-builder-positions builder))
                                         '(simple-array double-float (*)))
                                 (coerce (nreverse (mesh-builder-indices builder))
                                         '(simple-array (unsigned-byte 32) (*))))
                           result)))
                 builders)
        result))))

(defun %batch-object (color positions indices)
  (let* ((geometry (sgeo.geometry:make-triangle-mesh
                   :positions positions :indices indices :name "Geometria de depuração"))
         (material (sgeo.scene:make-material :color color :name "Material de depuração"))
         (object (sgeo.scene:make-mesh-object geometry :name "Lote de depuração"
                                               :material material)))
    (%make-debug-batch :object object :positions (copy-seq positions)
                       :indices (copy-seq indices))))

(defun %ensure-batch (state color positions indices)
  (let* ((batches (debug-state-batches state))
         (batch (gethash color batches)))
    (cond
      ((null batch)
       (setf batch (%batch-object color positions indices)
             (gethash (copy-seq color) batches) batch))
      ((or (not (equalp positions (debug-batch-positions batch)))
           (not (equalp indices (debug-batch-indices batch))))
       (sgeo.geometry:set-mesh-data (sgeo.scene:mesh-object-geometry
                                     (debug-batch-object batch))
                                    positions indices)
       (setf (debug-batch-positions batch) (copy-seq positions)
             (debug-batch-indices batch) (copy-seq indices))))
    batch))

(defun %batch-entry (batch)
  (let* ((object (debug-batch-object batch))
         (geometry (sgeo.scene:mesh-object-geometry object))
         (material (sgeo.scene:mesh-object-material object))
         (data (sgeo.scene:render-data-for-object object)))
    (list :object object :object-id (sgeo.core:object-id object)
          :geometry geometry :render-key geometry
          :revision (sgeo.geometry:render-mesh-revision data)
          :positions (sgeo.geometry:render-mesh-positions data)
          :normals (sgeo.geometry:render-mesh-normals data)
          :indices (sgeo.geometry:render-mesh-indices data)
          :model-matrix (sgeo.scene:world-transform object)
          :material material :color (sgeo.scene:simple-material-color material)
          :wireframe-p (sgeo.scene:simple-material-wireframe-p material)
          :visible-p t)))

(defmethod sgeo.scene:additional-render-entries ((world sgeo.scene:world))
  (sgeo.scene:with-world-lock (world)
    (let ((state (sgeo.scene:world-debug-state world)))
      (when state
        (mapcar (lambda (geometry)
                  (destructuring-bind (color positions indices) geometry
                    (%batch-entry (%ensure-batch state color positions indices))))
                (%collect-geometry world (debug-state-commands state)))))))
