(in-package #:sgeo.debug)

(defstruct (debug-command (:constructor %make-debug-command))
  kind data color width duration remaining)

(defstruct (debug-batch (:constructor %make-debug-batch))
  object positions indices)

(defstruct (debug-state (:constructor %make-debug-state))
  (commands nil)
  (batches (make-hash-table :test #'equalp)))

(defstruct (mesh-builder (:constructor %make-mesh-builder))
  (positions nil)
  (indices nil)
  (vertex-count 0))

(defun %finite-real-p (value)
  (and (realp value)
       (handler-case
           (let ((number (coerce value 'double-float)))
             (and (<= (- most-positive-double-float) number)
                  (<= number most-positive-double-float)))
         (error () nil))))

(defun %vector3 (value context)
  (unless (and (typep value 'sequence) (= (length value) 3)
               (every #'%finite-real-p value))
    (error "~A precisa ter três componentes reais e finitos." context))
  (map 'vector (lambda (part) (coerce part 'double-float)) value))

(defun %color (value)
  (let ((copy (%vector3 value "A cor")))
    (unless (every (lambda (component) (<= 0d0 component 1d0)) copy)
      (error "A cor precisa estar no intervalo RGB [0, 1]."))
    copy))

(defun %duration (value)
  (unless (and (%finite-real-p value) (or (= value -1) (>= value 0)))
    (error "A duração precisa ser zero, positiva ou -1 para persistir."))
  (coerce value 'double-float))

(defun %positive-width (value)
  (unless (and (%finite-real-p value) (> value 0))
    (error "A largura precisa ser um número real positivo e finito."))
  (coerce value 'double-float))

(defun %ensure-state (world)
  (or (sgeo.scene:world-debug-state world)
      (setf (sgeo.scene:world-debug-state world) (%make-debug-state))))

(defun %queue-command (world kind data color width duration)
  (sgeo.scene:with-world-lock (world)
    (let ((command (%make-debug-command :kind kind :data data :color (%color color)
                                        :width (%positive-width width)
                                        :duration (%duration duration)
                                        :remaining (%duration duration))))
      (push command (debug-state-commands (%ensure-state world)))))
  world)

(defun debug-line (world a b &key (color #(1d0 0.35d0 0.08d0))
                                  (width 0.01d0) (duration 0d0))
  "Enfileira uma linha de depuração como cópias imutáveis dos pontos."
  (let ((from (%vector3 a "O início da linha"))
        (to (%vector3 b "O fim da linha")))
    (%queue-command world :line (list :a from :b to) color width duration)))

(defun debug-ray (world ray &key (length 1d0) (color #(0.15d0 0.85d0 1d0))
                               (width 0.01d0) (duration 0d0))
  "Desenha um raio até LENGTH unidades a partir de sua origem."
  (unless (typep ray 'sgeo.math:ray)
    (error "DEBUG-RAY precisa receber um raio de Sgeo.Math."))
  (unless (and (%finite-real-p length) (> length 0))
    (error "O comprimento do raio precisa ser positivo e finito."))
  (let* ((origin (%vector3 (sgeo.math:ray-origin ray) "A origem do raio"))
         (direction (sgeo.math:normalize (sgeo.math:ray-direction ray)))
         (finish (sgeo.math:v+ origin (sgeo.math:v* direction (coerce length 'double-float)))))
    (debug-line world origin finish :color color :width width :duration duration)))

(defun debug-aabb (world bounds &key (color #(0.15d0 1d0 0.35d0))
                                    (width 0.01d0) (duration 0d0))
  "Enfileira as doze arestas de uma caixa alinhada aos eixos."
  (unless (typep bounds 'sgeo.math:aabb)
    (error "DEBUG-AABB precisa receber uma caixa AABB."))
  (%queue-command world :aabb
                  (list :minimum (%vector3 (sgeo.math:aabb-min bounds) "O mínimo da caixa")
                        :maximum (%vector3 (sgeo.math:aabb-max bounds) "O máximo da caixa"))
                  color width duration))

(defun debug-sphere (world center radius &key (color #(1d0 0.9d0 0.15d0))
                                          (width 0.01d0) (duration 0d0))
  "Enfileira uma esfera representada por três grandes círculos."
  (unless (and (%finite-real-p radius) (> radius 0))
    (error "O raio da esfera precisa ser positivo e finito."))
  (%queue-command world :sphere
                  (list :center (%vector3 center "O centro da esfera")
                        :radius (coerce radius 'double-float))
                  color width duration))

(defun debug-text (world position text &key (color #(1d0 1d0 1d0))
                                           (height 0.14d0) (duration 0d0))
  "Desenha texto com uma fonte bitmap 5x7 incorporada ao pacote."
  (unless (stringp text) (error "O texto de depuração precisa ser uma string."))
  (unless (and (%finite-real-p height) (> height 0))
    (error "A altura do texto precisa ser positiva e finita."))
  (%queue-command world :text
                  (list :position (%vector3 position "A posição do texto")
                        :text (copy-seq text) :height (coerce height 'double-float))
                  color 0.01d0 duration))

(defun clear-debug-draw (world)
  "Apaga comandos e lotes transitórios do mundo."
  (sgeo.scene:with-world-lock (world)
    (when (sgeo.scene:world-debug-state world)
      (let ((state (sgeo.scene:world-debug-state world)))
        (setf (debug-state-commands state) nil)
        (clrhash (debug-state-batches state)))))
  world)

(defun debug-command-count (world)
  "Devolve quantos comandos ainda aguardam expiração ou limpeza."
  (sgeo.scene:with-world-lock (world)
    (if (sgeo.scene:world-debug-state world)
        (length (debug-state-commands (sgeo.scene:world-debug-state world)))
        0)))

(defmethod sgeo.scene:advance-scene-frame :before
    ((world sgeo.scene:world) state dt)
  (declare (ignore state))
  (sgeo.scene:with-world-lock (world)
    (let ((debug-state (sgeo.scene:world-debug-state world)))
      (when debug-state
        (setf (debug-state-commands debug-state)
              (loop for command in (debug-state-commands debug-state)
                    for remaining = (debug-command-remaining command)
                    for next = (if (plusp remaining)
                                   (- remaining (coerce dt 'double-float))
                                   remaining)
                    unless (and (not (= (debug-command-duration command) -1d0))
                                (<= next 0d0))
                      collect (let ((copy (copy-debug-command command)))
                                (setf (debug-command-remaining copy) next)
                                copy)))))))

