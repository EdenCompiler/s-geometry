(in-package #:sgeo.assets)

(define-condition asset-error (error)
  ((message :initarg :message :reader asset-error-message))
  (:report (lambda (condition stream) (write-string (asset-error-message condition) stream))))
(define-condition asset-validation-error (asset-error) ())
(define-condition asset-pack-error (asset-error) ())

(defconstant +pack-version+ 2)
(defconstant +max-field-size+ (* 256 1024 1024))
(defconstant +max-manifest-assets+ 100000)
(defparameter +pack-magic+ #(83 71 65 80 13 10 26 10))
(defstruct (importer (:constructor %make-importer (name version function)))
  name version function)
(defstruct (packed-asset (:constructor %make-packed-asset
                            (id name importer importer-version dependencies bytes source-hash payload-hash options-hash)))
  id name importer importer-version dependencies bytes source-hash payload-hash options-hash)
(defstruct (asset-pack (:constructor %make-asset-pack (assets version))) assets version)
(defstruct (asset-watcher (:constructor %make-asset-watcher
                            (manifest path pack state on-error)))
  manifest path pack state on-error (last-error nil) (disposed-p nil))

(defvar *importers* (make-hash-table :test #'equal))
(defvar *importer-lock* (bt:make-lock "sgeo asset importers"))
(defvar *write-lock* (bt:make-lock "sgeo asset cache writes"))
(defvar *temporary-counter* 0)

(defun %fail (type control &rest arguments)
  (error type :message (apply #'format nil control arguments)))

(defun %bytes (value)
  (unless (and (typep value '(vector (unsigned-byte 8))) (not (stringp value)))
    (%fail 'asset-validation-error "An asset importer must return an octet vector."))
  (coerce value '(simple-array (unsigned-byte 8) (*))))

(defun %sha256 (bytes)
  (ironclad:byte-array-to-hex-string (ironclad:digest-sequence :sha256 (%bytes bytes))))

(defun %asset-id (importer-name importer-version source-hash dependency-ids payload-hash options-hash)
  ;; O hash do produto também integra a identidade; importadores inconsistentes
  ;; não podem produzir bytes diferentes sob o mesmo ID de ativo.
  (%sha256 (concatenate '(vector (unsigned-byte 8))
                        (%utf8 (format nil "SGEO-ASSET~%~A~%~A~%~A~%~{~A~%~}"
                                       importer-name importer-version source-hash dependency-ids))
                        (%utf8 (format nil "~A~%~A~%" payload-hash options-hash)))))

(defun %utf8 (string)
  (let ((bytes (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (labels ((emit (byte) (vector-push-extend byte bytes)))
      (loop for character across string for code = (char-code character) do
        (cond
          ((<= code #x7f) (emit code))
          ((<= code #x7ff)
           (emit (logior #xc0 (ash code -6)))
           (emit (logior #x80 (logand code #x3f))))
          ((and (<= code #xffff) (not (<= #xd800 code #xdfff)))
           (emit (logior #xe0 (ash code -12)))
           (emit (logior #x80 (logand (ash code -6) #x3f)))
           (emit (logior #x80 (logand code #x3f))))
          ((<= code #x10ffff)
           (emit (logior #xf0 (ash code -18)))
           (emit (logior #x80 (logand (ash code -12) #x3f)))
           (emit (logior #x80 (logand (ash code -6) #x3f)))
           (emit (logior #x80 (logand code #x3f))))
          (t (%fail 'asset-validation-error "Invalid Unicode character in asset metadata."))))
      (coerce bytes '(simple-array (unsigned-byte 8) (*))))))

(defun %decode-utf8 (bytes)
  (let ((characters nil) (index 0) (length (length bytes)))
    (labels ((continuation (position)
               (when (>= position length) (%fail 'asset-pack-error "Invalid UTF-8 in asset pack."))
               (let ((byte (aref bytes position)))
                 (unless (<= #x80 byte #xbf)
                   (%fail 'asset-pack-error "Invalid UTF-8 in asset pack."))
                 (logand byte #x3f)))
             (emit-code (code)
               (let ((character (code-char code)))
                 (unless character (%fail 'asset-pack-error "Invalid Unicode code point in asset pack."))
                 (push character characters))))
      (loop while (< index length) for first = (aref bytes index) do
        (cond
          ((< first #x80) (emit-code first) (incf index))
          ((<= #xc2 first #xdf)
           (emit-code (logior (ash (logand first #x1f) 6) (continuation (1+ index))))
           (incf index 2))
          ((<= #xe0 first #xef)
           (let* ((second (continuation (1+ index)))
                  (third (continuation (+ index 2)))
                  (code (logior (ash (logand first #x0f) 12) (ash second 6) third)))
             (when (or (and (= first #xe0) (< second #x20))
                       (and (= first #xed) (>= second #x20))
                       (<= #xd800 code #xdfff))
               (%fail 'asset-pack-error "Invalid UTF-8 in asset pack."))
             (emit-code code))
           (incf index 3))
          ((<= #xf0 first #xf4)
           (let* ((second (continuation (1+ index)))
                  (third (continuation (+ index 2)))
                  (fourth (continuation (+ index 3)))
                  (code (logior (ash (logand first 7) 18) (ash second 12) (ash third 6) fourth)))
             (when (or (and (= first #xf0) (< second #x10))
                       (and (= first #xf4) (> second #x0f))
                       (> code #x10ffff))
               (%fail 'asset-pack-error "Invalid UTF-8 in asset pack."))
             (emit-code code))
           (incf index 4))
          (t (%fail 'asset-pack-error "Invalid UTF-8 in asset pack."))))
      (coerce (nreverse characters) 'string))))

(defun %safe-name-p (name)
  (and (stringp name) (plusp (length name))
       (not (or (search ".." name) (find #\/ name) (find #\\ name) (find #\Null name)))
       (every (lambda (character)
                (or (alphanumericp character) (find character "-_ .@+"))) name)))

(defun register-importer (name function &key (version "1"))
  "Registra um importador puro que retorna bytes para um caminho e uma especificação."
  (unless (and (stringp name) (plusp (length name)) (functionp function)
               (stringp version) (plusp (length version)))
    (%fail 'asset-validation-error "Importer name, version and function are required."))
  (bt:with-lock-held (*importer-lock*)
    (setf (gethash name *importers*) (%make-importer name version function)))
  name)

(defun unregister-importer (name)
  "Remove um importador registrado."
  (bt:with-lock-held (*importer-lock*) (remhash name *importers*)))

(defun find-importer (name)
  "Retorna o importador registrado ou NIL."
  (bt:with-lock-held (*importer-lock*) (gethash name *importers*)))

(defun %read-bytes (path)
  (with-open-file (stream path :direction :input :element-type '(unsigned-byte 8))
    (let* ((length (file-length stream))
           (bytes (make-array length :element-type '(unsigned-byte 8))))
      (unless (= (read-sequence bytes stream) length)
        (%fail 'asset-validation-error "Could not read complete source file ~A." path))
      bytes)))

(defun %put-u32 (stream value)
  (unless (and (integerp value) (<= 0 value #xffffffff))
    (%fail 'asset-validation-error "Asset pack field exceeds the 32-bit format limit."))
  (dotimes (index 4) (write-byte (ldb (byte 8 (* 8 index)) value) stream)))

(defun %put-u64 (stream value)
  (unless (and (integerp value) (<= 0 value #xffffffffffffffff))
    (%fail 'asset-validation-error "Asset payload exceeds the 64-bit format limit."))
  (dotimes (index 8) (write-byte (ldb (byte 8 (* 8 index)) value) stream)))

(defun %put-string (stream string)
  (let ((bytes (%utf8 string)))
    (%put-u32 stream (length bytes))
    (write-sequence bytes stream)))

(defun %put-string-list (stream strings)
  (%put-u32 stream (length strings))
  (dolist (string strings) (%put-string stream string)))

(defun %write-pack (assets path)
  (with-open-file (stream path :direction :output :if-exists :error
                          :if-does-not-exist :create :element-type '(unsigned-byte 8))
    (write-sequence +pack-magic+ stream)
    (%put-u32 stream +pack-version+)
    (%put-u32 stream (length assets))
    (dolist (asset assets)
      (%put-string stream (packed-asset-id asset))
      (%put-string stream (packed-asset-name asset))
      (%put-string stream (packed-asset-importer asset))
      (%put-string stream (packed-asset-importer-version asset))
      (%put-string stream (packed-asset-source-hash asset))
      (%put-string-list stream (packed-asset-dependencies asset))
      (%put-string stream (packed-asset-payload-hash asset))
      (%put-string stream (packed-asset-options-hash asset))
      (%put-u64 stream (length (packed-asset-bytes asset)))
      (write-sequence (packed-asset-bytes asset) stream))
    (finish-output stream))
  path)

(defun %temporary-pathname (target)
  (let ((counter (bt:with-lock-held (*write-lock*) (incf *temporary-counter*))))
    (make-pathname :name (format nil ".~A.sgp-~D-~D"
                                 (or (pathname-name target) "assets")
                                 (get-universal-time) counter)
                   :type (pathname-type target) :defaults target)))

(defun %plist-value (plist key &optional default)
  (loop for (candidate value) on plist by #'cddr
        when (eq candidate key) do (return value)
        finally (return default)))

(defun %proper-plist-p (value)
  (let ((tail value) (seen (make-hash-table :test #'eq)) (keys nil))
    (loop while (consp tail) do
      (when (gethash tail seen) (return-from %proper-plist-p nil))
      (setf (gethash tail seen) t)
      (unless (and (consp (cdr tail)) (keywordp (car tail))
                   (not (member (car tail) keys :test #'eq)))
        (return-from %proper-plist-p nil))
      (push (car tail) keys)
      (setf tail (cddr tail)))
    (null tail)))

(defun %proper-list-p (value &optional maximum-length)
  (let ((tail value) (seen (make-hash-table :test #'eq)) (count 0))
    (loop while (consp tail) do
      (when (gethash tail seen) (return-from %proper-list-p nil))
      (setf (gethash tail seen) t tail (cdr tail))
      (when (and maximum-length (> (incf count) maximum-length))
        (return-from %proper-list-p nil)))
    (null tail)))

(defun %finite-real-p (value)
  (and (realp value)
       (handler-case
           (let ((number (coerce value 'double-float)))
             (and (= number number) (< (abs number) most-positive-double-float)))
         (error () nil))))

(defun %copy-option-value (value &optional (active (make-hash-table :test #'eq)))
  (cond
    ((stringp value) (copy-seq value))
    ((or (null value) (eq value t) (keywordp value)) value)
    ((numberp value) (if (%finite-real-p value) value
                         (%fail 'asset-validation-error "Importer options require finite real numbers.")))
    ((consp value)
     (when (gethash value active)
       (%fail 'asset-validation-error "Importer options cannot contain circular data."))
     (setf (gethash value active) t)
     (let ((copy (cons (%copy-option-value (car value) active)
                       (%copy-option-value (cdr value) active))))
       (remhash value active)
       copy))
    ((and (vectorp value) (not (stringp value)))
     (when (gethash value active)
       (%fail 'asset-validation-error "Importer options cannot contain circular data."))
     (setf (gethash value active) t)
     (let ((copy (map 'list (lambda (item) (%copy-option-value item active)) value)))
       (remhash value active)
       copy))
    ((hash-table-p value)
     (when (gethash value active)
       (%fail 'asset-validation-error "Importer options cannot contain circular data."))
     (setf (gethash value active) t)
     (let ((pairs nil))
       (maphash (lambda (key item)
                  (unless (or (stringp key) (keywordp key))
                    (%fail 'asset-validation-error "Importer option map keys must be strings or keywords."))
                  (push (list (%copy-option-value key active)
                              (%copy-option-value item active)) pairs)) value)
       (remhash value active)
       (list :map (sort pairs #'string< :key #'prin1-to-string))))
    (t (%fail 'asset-validation-error "Importer options contain an unsupported value of type ~S."
              (type-of value)))))

(defun %options-hash (spec)
  (let* ((excluded '(:name :source :importer :dependencies :dependency-products))
         (options (loop for (key value) on spec by #'cddr
                        unless (member key excluded :test #'eq)
                          collect (list key (%copy-option-value value))))
         (canonical (sort options #'string< :key (lambda (pair) (symbol-name (first pair)))))
         (*print-readably* t) (*print-escape* t) (*print-array* nil)
         (*print-base* 10) (*print-radix* nil) (*print-circle* nil)
         (*print-gensym* t) (*print-pretty* nil) (*print-case* :upcase)
         (*print-level* nil) (*print-length* nil) (*print-lines* nil)
         (*package* (find-package :keyword)))
    (%sha256 (%utf8 (with-output-to-string (stream) (prin1 canonical stream))))))

(defun %normalize-specs (manifest)
  (unless (%proper-list-p manifest +max-manifest-assets+)
    (%fail 'asset-validation-error "Asset manifest must be a finite proper list."))
  (let ((specs nil) (names (make-hash-table :test #'equal)))
    (dolist (spec manifest)
        (unless (%proper-plist-p spec)
          (%fail 'asset-validation-error "Each asset must be a property list."))
      (let* ((name (%plist-value spec :name))
             (source (%plist-value spec :source))
             (importer-name (%plist-value spec :importer "bytes"))
             (dependencies (%plist-value spec :dependencies nil)))
        (unless (%safe-name-p name)
          (%fail 'asset-validation-error "Asset names must be safe identifiers without path separators: ~S." name))
        (when (gethash name names) (%fail 'asset-validation-error "Duplicate asset name ~S." name))
        (unless (and source (probe-file source))
          (%fail 'asset-validation-error "Asset source does not exist for ~S." name))
        (when (member :dependency-products spec :test #'eq)
          (%fail 'asset-validation-error ":DEPENDENCY-PRODUCTS is reserved for the importer runtime."))
        (unless (and (%proper-list-p dependencies) (every #'stringp dependencies))
          (%fail 'asset-validation-error "Dependencies for ~S must be asset names." name))
        (unless (= (length dependencies) (length (remove-duplicates (copy-list dependencies) :test #'string=)))
          (%fail 'asset-validation-error "Dependencies for ~S must not contain duplicates." name))
        (unless (find-importer importer-name)
          (%fail 'asset-validation-error "No importer is registered as ~S." importer-name))
        (setf (gethash name names) t)
        (push (list :name name :source (pathname source) :importer importer-name
                    :dependencies (copy-list dependencies) :original spec) specs)))
    (setf specs (nreverse specs))
    (dolist (spec specs)
      (dolist (dependency (getf spec :dependencies))
        (unless (gethash dependency names)
          (%fail 'asset-validation-error "Unknown dependency ~S of asset ~S." dependency (getf spec :name)))))
    specs))

(defun %resolve-specs (specs)
  (let ((by-name (make-hash-table :test #'equal))
        (resolved (make-hash-table :test #'equal)) (visiting (make-hash-table :test #'equal)))
    (dolist (spec specs) (setf (gethash (getf spec :name) by-name) spec))
    (labels ((resolve-one (name)
               (or (gethash name resolved)
                   (progn
                     (when (gethash name visiting)
                       (%fail 'asset-validation-error "Asset dependency cycle at ~S." name))
                     (setf (gethash name visiting) t)
                     (let* ((spec (gethash name by-name))
                            (dependency-products
                              (mapcar (lambda (dependency-name)
                                        (cons dependency-name (resolve-one dependency-name)))
                                      (getf spec :dependencies)))
                            (dependencies (sort (mapcar #'cdr (copy-list dependency-products))
                                                #'string< :key #'packed-asset-id))
                            (importer (find-importer (getf spec :importer)))
                            (source-bytes (%read-bytes (getf spec :source)))
                            (source-hash (%sha256 source-bytes))
                            (options-hash (%options-hash (getf spec :original)))
                            (importer-spec
                              (append (getf spec :original)
                                      (list :dependency-products
                                            (mapcar (lambda (entry)
                                                      (let ((asset (cdr entry)))
                                                        (list :name (car entry)
                                                              :id (packed-asset-id asset)
                                                              :importer (packed-asset-importer asset)
                                                              :source-hash (packed-asset-source-hash asset)
                                                              :payload-hash (packed-asset-payload-hash asset)
                                                              :bytes (packed-asset-bytes asset))))
                                                    dependency-products))))
                            (payload (%bytes (funcall (importer-function importer)
                                                     (getf spec :source) importer-spec)))
                            (payload-hash (%sha256 payload))
                            (dep-ids (mapcar #'packed-asset-id dependencies))
                            (id (%asset-id (importer-name importer) (importer-version importer)
                                           source-hash dep-ids payload-hash options-hash))
                            (asset (%make-packed-asset id (getf spec :name)
                                                       (importer-name importer) (importer-version importer)
                                                       dep-ids payload source-hash payload-hash options-hash)))
                       (remhash name visiting)
                       (setf (gethash name resolved) asset))))))
      (mapcar (lambda (spec) (resolve-one (getf spec :name))) specs))))

(defun %pack-assets (assets)
  (let ((by-id (make-hash-table :test #'equal)))
    (dolist (asset assets)
      (let ((prior (gethash (packed-asset-id asset) by-id)))
        (when (and prior
                   (not (and (string= (packed-asset-payload-hash prior) (packed-asset-payload-hash asset))
                             (string= (packed-asset-source-hash prior) (packed-asset-source-hash asset))
                             (equal (packed-asset-dependencies prior) (packed-asset-dependencies asset))
                             (string= (packed-asset-importer prior) (packed-asset-importer asset))
                             (string= (packed-asset-importer-version prior)
                                      (packed-asset-importer-version asset))
                             (string= (packed-asset-options-hash prior)
                                      (packed-asset-options-hash asset)))))
          (%fail 'asset-validation-error "SHA-256 asset ID collision for ~S." (packed-asset-name asset)))
        (setf (gethash (packed-asset-id asset) by-id) asset)))
    (sort (copy-list assets)
          (lambda (left right)
            (or (string< (packed-asset-id left) (packed-asset-id right))
                (and (string= (packed-asset-id left) (packed-asset-id right))
                     (string< (packed-asset-name left) (packed-asset-name right))))))))

(defun compile-assets (manifest output)
  "Compila fontes não confiáveis em um cache SGP determinístico e substituído atomicamente."
  (let* ((specs (%normalize-specs manifest))
         (assets (%pack-assets (%resolve-specs specs)))
         (target (pathname output))
         (temporary (%temporary-pathname target)))
    (unwind-protect
         (progn
           (%write-pack assets temporary)
           ;; Valida o arquivo completo antes de substituir o cache anterior.
           (load-asset-pack temporary)
           (uiop:rename-file-overwriting-target temporary target)
           target)
      (when (probe-file temporary) (ignore-errors (delete-file temporary))))))

(defun %read-u32 (stream)
  (let ((value 0))
    (dotimes (index 4 value)
      (let ((byte (read-byte stream nil nil)))
        (unless byte (%fail 'asset-pack-error "Truncated asset pack."))
        (setf value (logior value (ash byte (* 8 index))))))))

(defun %read-u64 (stream)
  (let ((value 0))
    (dotimes (index 8 value)
      (let ((byte (read-byte stream nil nil)))
        (unless byte (%fail 'asset-pack-error "Truncated asset pack."))
        (setf value (logior value (ash byte (* 8 index))))))))

(defun %read-exact (stream length)
  (unless (and (integerp length) (<= 0 length +max-field-size+))
    (%fail 'asset-pack-error "Asset pack field is outside the supported size limit."))
  (let ((position (file-position stream)) (total (file-length stream)))
    (unless (and (integerp position) (integerp total) (<= length (- total position)))
      (%fail 'asset-pack-error "Truncated asset pack.")))
  (let ((bytes (make-array length :element-type '(unsigned-byte 8))))
    (unless (= (read-sequence bytes stream) length) (%fail 'asset-pack-error "Truncated asset pack."))
    bytes))

(defun %read-string (stream)
  (%decode-utf8 (%read-exact stream (%read-u32 stream))))

(defun %read-string-list (stream)
  (let ((count (%read-u32 stream)))
    (when (> count 1000000) (%fail 'asset-pack-error "Asset pack has too many dependencies."))
    (loop repeat count collect (%read-string stream))))

(defun %hex-hash-p (value)
  (and (stringp value) (= (length value) 64)
       (every (lambda (ch) (or (digit-char-p ch 16) (find ch "abcdef"))) value)))

(defun load-asset-pack (path)
  "Lê e valida um pacote; bytes são dados e nunca são executados como código Lisp."
  (with-open-file (stream path :direction :input :element-type '(unsigned-byte 8))
    (unless (equalp (%read-exact stream (length +pack-magic+)) +pack-magic+)
      (%fail 'asset-pack-error "Invalid asset pack magic."))
    (let ((version (%read-u32 stream)) (count nil) (assets nil)
          (seen-ids (make-hash-table :test #'equal)) (seen-names (make-hash-table :test #'equal)))
      (unless (= version +pack-version+)
        (%fail 'asset-pack-error "Unsupported asset pack version ~D." version))
      (setf count (%read-u32 stream))
      (when (> count +max-manifest-assets+)
        (%fail 'asset-pack-error "Asset pack has too many records."))
      (dotimes (index count)
        (declare (ignorable index))
        (let* ((id (%read-string stream)) (name (%read-string stream))
               (importer (%read-string stream)) (importer-version (%read-string stream))
               (source-hash (%read-string stream)) (dependencies (%read-string-list stream))
               (payload-hash (%read-string stream)) (options-hash (%read-string stream))
               (length (%read-u64 stream))
               (payload (%read-exact stream length)))
          (unless (and (%hex-hash-p id) (%hex-hash-p source-hash) (%hex-hash-p payload-hash)
                       (%hex-hash-p options-hash)
                       (%safe-name-p name) (not (gethash name seen-names)))
            (%fail 'asset-pack-error "Invalid or duplicate asset record."))
          (unless (and (every #'%hex-hash-p dependencies)
                       (string= id (%asset-id importer importer-version source-hash dependencies
                                              payload-hash options-hash)))
            (%fail 'asset-pack-error "Asset ID or dependency metadata is invalid for ~A." name))
          (unless (string= payload-hash (%sha256 payload))
            (%fail 'asset-pack-error "Asset payload integrity check failed for ~A." name))
          (let ((prior (gethash id seen-ids)))
            (when (and prior
                       (not (and (string= (packed-asset-payload-hash prior) payload-hash)
                                 (string= (packed-asset-source-hash prior) source-hash)
                                 (string= (packed-asset-options-hash prior) options-hash)
                                 (equal (packed-asset-dependencies prior) dependencies)
                                 (string= (packed-asset-importer prior) importer)
                                 (string= (packed-asset-importer-version prior) importer-version))))
              (%fail 'asset-pack-error "SHA-256 asset ID collision in cache."))
            (unless prior
              (setf (gethash id seen-ids)
                    (%make-packed-asset id name importer importer-version dependencies
                                        #() source-hash payload-hash options-hash))))
          (setf (gethash name seen-names) t)
          (push (%make-packed-asset id name importer importer-version dependencies
                                    payload source-hash payload-hash options-hash) assets)))
      (unless (null (read-byte stream nil nil))
        (%fail 'asset-pack-error "Unexpected trailing bytes in asset pack."))
      (setf assets (nreverse assets))
      (loop for rest on assets while (cdr rest)
            for previous = (car rest)
            for asset = (cadr rest)
            do (when (or (string> (packed-asset-id previous) (packed-asset-id asset))
                         (and (string= (packed-asset-id previous) (packed-asset-id asset))
                              (not (string< (packed-asset-name previous) (packed-asset-name asset)))))
                 (%fail 'asset-pack-error "Asset records are not in canonical order.")))
      (dolist (asset assets)
        (unless (equal (packed-asset-dependencies asset)
                       (sort (remove-duplicates (copy-list (packed-asset-dependencies asset)) :test #'string=)
                             #'string<))
          (%fail 'asset-pack-error "Dependency IDs are not canonical for ~A." (packed-asset-name asset)))
        (dolist (dependency (packed-asset-dependencies asset))
          (unless (gethash dependency seen-ids)
            (%fail 'asset-pack-error "Missing dependency record for ~A." (packed-asset-name asset)))))
      (%make-asset-pack assets version))))

(defun find-packed-asset (pack name-or-id)
  "Procura um produto pelo nome lógico ou pelo ID SHA-256."
  (or (find name-or-id (asset-pack-assets pack) :test #'string= :key #'packed-asset-id)
      (find name-or-id (asset-pack-assets pack) :test #'string= :key #'packed-asset-name)))

(defun asset-pack-current-p (pack manifest)
  "Verifica se nomes, importadores, versões, fontes e dependências coincidem com o manifesto."
  (handler-case
      (let ((expected (%pack-assets (%resolve-specs (%normalize-specs manifest)))))
        (and (= (length expected) (length (asset-pack-assets pack)))
             (every (lambda (left right)
                      (and (string= (packed-asset-id left) (packed-asset-id right))
                           (string= (packed-asset-name left) (packed-asset-name right))))
                    expected (asset-pack-assets pack))))
    (error () nil)))

(defun load-or-build-asset-pack (manifest path)
  "Reutiliza um pacote atual ou reconstrói o cache a partir das fontes originais."
  (let ((pack (when (probe-file path) (ignore-errors (load-asset-pack path)))))
    (if (and pack (asset-pack-current-p pack manifest))
        pack
        (progn (compile-assets manifest path) (load-asset-pack path)))))

(defun %manifest-state (manifest)
  "Calcula uma assinatura limitada a arquivos e metadados, sem executar importadores."
  (let* ((specs (%normalize-specs manifest))
         (by-name (make-hash-table :test #'equal))
         (states (make-hash-table :test #'equal))
         (visiting (make-hash-table :test #'equal)))
    (dolist (spec specs) (setf (gethash (getf spec :name) by-name) spec))
    (labels ((state-one (name)
               (or (gethash name states)
                   (progn
                     (when (gethash name visiting)
                       (%fail 'asset-validation-error "Asset dependency cycle at ~S." name))
                     (setf (gethash name visiting) t)
                     (let* ((spec (gethash name by-name))
                            (importer (find-importer (getf spec :importer)))
                            (dependencies
                              (sort (mapcar (lambda (dependency)
                                              (list dependency (state-one dependency)))
                                            (getf spec :dependencies))
                                    #'string< :key #'first))
                            (state
                              (%sha256
                               (%utf8
                                (with-output-to-string (stream)
                                  (prin1 (list (getf spec :name) (getf spec :importer)
                                               (importer-version importer)
                                               (%sha256 (%read-bytes (getf spec :source)))
                                               (%options-hash (getf spec :original)) dependencies)
                                         stream))))))
                       (remhash name visiting)
                       (setf (gethash name states) state))))))
      (dolist (spec specs) (state-one (getf spec :name)))
      (let ((*print-readably* t) (*print-escape* t) (*print-pretty* nil)
            (*print-circle* nil) (*print-base* 10) (*print-radix* nil)
            (*package* (find-package :keyword)))
        (%sha256 (%utf8 (with-output-to-string (stream)
                          (prin1 (sort (loop for spec in specs
                                             collect (list (getf spec :name)
                                                           (gethash (getf spec :name) states)))
                                       #'string< :key #'first)
                                 stream))))))))

(defun make-asset-watcher (manifest path &key on-error)
  "Cria um watcher de polling síncrono; não cria threads nem recursos de fundo."
  (when (and on-error (not (functionp on-error)))
    (%fail 'asset-validation-error ":ON-ERROR precisa ser uma função."))
  ;; Valida listas e opções circulares antes de copiá-las para o estado do watcher.
  (let ((state (%manifest-state manifest)))
    (let* ((stable-manifest (copy-tree manifest))
           (pack (load-or-build-asset-pack stable-manifest path)))
      (%make-asset-watcher stable-manifest (pathname path) pack state on-error))))

(defun poll-asset-watcher (watcher)
  "Verifica uma vez as fontes; retorna pacote, flag de rebuild e condição de erro."
  (unless (typep watcher 'asset-watcher)
    (%fail 'asset-validation-error "Watcher de ativos inválido."))
  (when (asset-watcher-disposed-p watcher)
    (%fail 'asset-validation-error "Watcher de ativos já foi encerrado."))
  (handler-case
      (let ((state (%manifest-state (asset-watcher-manifest watcher))))
        (if (string= state (asset-watcher-state watcher))
            (values (asset-watcher-pack watcher) nil nil)
            (progn
              (compile-assets (asset-watcher-manifest watcher) (asset-watcher-path watcher))
              (setf (asset-watcher-pack watcher) (load-asset-pack (asset-watcher-path watcher))
                    (asset-watcher-state watcher) state
                    (asset-watcher-last-error watcher) nil)
              (values (asset-watcher-pack watcher) t nil))))
    (error (condition)
      (setf (asset-watcher-last-error watcher) condition)
      (when (asset-watcher-on-error watcher)
        (ignore-errors (funcall (asset-watcher-on-error watcher) condition)))
      (values (asset-watcher-pack watcher) nil condition))))

(defun stop-asset-watcher (watcher)
  "Encerra um watcher síncrono e libera manifesto e assinatura mantidos por ele."
  (unless (typep watcher 'asset-watcher)
    (%fail 'asset-validation-error "Watcher de ativos inválido."))
  (setf (asset-watcher-disposed-p watcher) t
        (asset-watcher-manifest watcher) nil
        (asset-watcher-state watcher) nil)
  watcher)

(register-importer "bytes"
                   (lambda (pathname spec)
                     (declare (ignore spec))
                     (%read-bytes pathname))
                   :version "1")
