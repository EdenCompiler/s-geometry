(in-package #:sgeo.assets)

(defun %scene-id-map (data)
  (let ((mapping (make-hash-table :test #'equal)) (next-id 0))
    (labels ((register (records)
               (dolist (record records)
                 (let ((id (getf record :id)))
                   (unless (and (integerp id) (not (gethash id mapping)))
                     (%fail 'asset-validation-error "Scene contains an invalid or repeated object ID."))
                   (setf (gethash id mapping) (incf next-id)))))
             (id-list (key)
               (let ((plist (if (and (consp data) (eq (first data) :sgeo-scene))
                                (rest data) data)))
                 (loop for tail on plist by #'cddr
                       when (eq (car tail) key) return (cadr tail)))))
      (register (id-list :objects))
      (register (id-list :geometries))
      (register (id-list :materials))
      mapping)))

(defun %canonical-scene-data (data)
  (let ((ids (%scene-id-map data)))
    (labels ((mapped-id (id)
               (or (gethash id ids)
                   (%fail 'asset-validation-error "Scene contains a reference to an unknown object ID.")))
             (rewrite-list (list)
               (cond
                 ((and (consp list) (keywordp (first list)) (evenp (length list)))
                  (loop for (key value) on list by #'cddr
                        append (list key
                                     (cond
                                       ;; Estes dados têm IDs locais ou parâmetros literais próprios.
                                       ((member key '(:metadata :procedural) :test #'eq) value)
                                       ((member key '(:id :root-id :camera-id :selection-id :parent-id
                                                      :geometry-id :material-id :target-id :object-id
                                                      :root-target-id :root-joint-id)
                                                :test #'eq)
                                        (if value (mapped-id value) nil))
                                       ((eq key :joints) (mapcar #'mapped-id value))
                                       (t (rewrite-value value))))))
                 (t (mapcar #'rewrite-value list))))
             (rewrite-value (value)
               (if (consp value) (rewrite-list value) value)))
      (if (and (consp data) (eq (first data) :sgeo-scene))
          (cons :sgeo-scene (rewrite-list (rest data)))
          (rewrite-list data)))))

(defun %canonical-data-bytes (data)
  (let ((*print-readably* t) (*print-escape* t) (*print-array* nil)
        (*print-base* 10) (*print-radix* nil) (*print-circle* nil)
        (*print-gensym* t) (*print-pretty* nil) (*print-case* :upcase)
        (*print-level* nil) (*print-length* nil) (*print-lines* nil)
        (*package* (find-package :keyword)))
    (%utf8 (with-output-to-string (stream) (prin1 data stream) (terpri stream)))))

(defun %canonical-scene-bytes (world &key remove-gltf-source-metadata)
  (when remove-gltf-source-metadata
    ;; IMPORT-GLTF cria esta chave internamente e guarda nela caminhos e a fonte original.
    (remhash :gltf-sources (sgeo.core:object-metadata (sgeo.scene:world-root world))))
  (%canonical-data-bytes (%canonical-scene-data (sgeo.serialization:scene-data world))))

(defun %scene-importer (source spec)
  (declare (ignore spec))
  (%canonical-scene-bytes (sgeo.serialization:load-world source)))

(defun %render-mesh-importer (source spec)
  (declare (ignore spec))
  (let* ((world (sgeo.serialization:load-world source))
         (objects (append (sgeo.scene::%descendants (sgeo.scene:world-root world))
                          (list (sgeo.scene:world-camera world))))
         (meshes
           (loop for object in objects
                 when (typep object 'sgeo.scene:mesh-object)
                   collect
                   (let* ((geometry (sgeo.scene:mesh-object-geometry object))
                          (render-data (sgeo.core:compile-render-data geometry)))
                     (list :name (sgeo.core:object-name object)
                           :positions (coerce (sgeo.geometry:render-mesh-positions render-data) 'list)
                           :normals (coerce (sgeo.geometry:render-mesh-normals render-data) 'list)
                           :indices (coerce (sgeo.geometry:render-mesh-indices render-data) 'list))))))
    (%canonical-data-bytes (list :sgeo-render-mesh :version 1 :meshes meshes))))

(defun %external-gltf-uris (document)
  (let ((uris nil))
    (dolist (key '("buffers" "images"))
      (loop for record across (sgeo.gltf::%arr (sgeo.gltf::%get document key))
            for uri = (sgeo.gltf::%get record "uri")
            when (and uri (not (and (>= (length uri) 5)
                                    (string-equal "data:" uri :end2 5))))
              do (push uri uris)))
    (sort (remove-duplicates uris :test #'string=) #'string<)))

(defun %external-resource-map (spec uris)
  (let* ((mappings (getf spec :external-resources))
         (dependency-products (getf spec :dependency-products))
         (known-dependencies (make-hash-table :test #'equal))
         (by-uri (make-hash-table :test #'equal)))
    (unless (and (listp mappings)
                 (every (lambda (mapping)
                          (and (consp mapping) (stringp (car mapping)) (stringp (cdr mapping))))
                        mappings))
      (%fail 'asset-validation-error "glTF assets with external files require :external-resources URI/name pairs."))
    (dolist (dependency dependency-products)
      (setf (gethash (getf dependency :name) known-dependencies) dependency))
    (dolist (mapping mappings)
      (when (gethash (car mapping) by-uri)
        (%fail 'asset-validation-error "Duplicate external glTF URI mapping ~S." (car mapping)))
      (unless (member (car mapping) uris :test #'string=)
        (%fail 'asset-validation-error "Manifest maps unused external glTF URI ~S." (car mapping)))
      (let ((dependency (gethash (cdr mapping) known-dependencies)))
        (unless dependency
          (%fail 'asset-validation-error "External glTF URI ~S is not a declared asset dependency." (car mapping)))
        (unless (string= (getf dependency :importer) "bytes")
          (%fail 'asset-validation-error "External glTF dependencies must use the bytes importer."))
        (setf (gethash (car mapping) by-uri) dependency)))
    (unless (= (length uris) (hash-table-count by-uri))
      (%fail 'asset-validation-error "Every external glTF resource must map to one declared byte asset."))
    by-uri))

(defun %gltf-importer (source spec)
  (let* ((document (nth-value 0 (sgeo.gltf::%load-document source)))
         (uris (%external-gltf-uris document))
         (resource-map (%external-resource-map spec uris))
         (source-path (truename source))
         (directory (make-pathname :name nil :type nil :defaults source-path)))
    (dolist (uri uris)
      (let* ((dependency (gethash uri resource-map))
             (referenced (sgeo.gltf::%resource-bytes uri directory))
             (hash (%sha256 referenced)))
        (unless (and (string= hash (getf dependency :source-hash))
                     (string= hash (getf dependency :payload-hash))
                     (equalp referenced (getf dependency :bytes)))
          (%fail 'asset-validation-error "External glTF resource ~S differs from its manifest asset." uri))))
    ;; A importação valida referências, buffers, materiais, malhas, esqueletos e animação.
    (let ((asset (sgeo.gltf:import-gltf source)))
      (%canonical-scene-bytes (sgeo.gltf:gltf-world asset) :remove-gltf-source-metadata t))))

(register-importer "scene" #'%scene-importer :version "2")
(register-importer "gltf" #'%gltf-importer :version "2")
(register-importer "render-mesh" #'%render-mesh-importer :version "1")
