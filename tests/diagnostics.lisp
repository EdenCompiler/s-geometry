(in-package #:sgeo.tests)
(in-suite sgeo-suite)

(defclass diagnostics-fake-renderer (sgeo.render:renderer)
  ((mode :initarg :mode :accessor diagnostics-fake-renderer-mode)))

(defmethod sgeo.render:render-frame ((renderer diagnostics-fake-renderer) world width height)
  (declare (ignore world width height))
  (ecase (diagnostics-fake-renderer-mode renderer)
    (:failure
     (setf (sgeo.render:renderer-last-error renderer)
           (make-condition 'simple-error :format-control "fake backend failure" :format-arguments nil))
     nil)
    (:success
     (setf (sgeo.render:renderer-last-error renderer) nil)
     (incf (sgeo.render:renderer-frame-count renderer))
     t)
    (:signal (error "uncaught fake backend failure"))))

(test diagnostics-renderer-failure-and-recovery
  (let ((profiler (sgeo.diagnostics:make-profiler))
        (renderer (make-instance 'diagnostics-fake-renderer :mode :failure)))
    (sgeo.diagnostics:with-profile-scope ("render-test" :profiler profiler)
      (is (null (sgeo.render:render-frame renderer nil 64 64))))
    (setf (diagnostics-fake-renderer-mode renderer) :success)
    (sgeo.diagnostics:with-profile-scope ("render-test" :profiler profiler)
      (is (sgeo.render:render-frame renderer nil 64 64)))
    (let* ((snapshot (sgeo.diagnostics:profiler-snapshot profiler))
           (errors (getf snapshot :errors))
           (recoveries (getf snapshot :recoveries)))
      (is (= 1 (length errors)))
      (is (equal "fake backend failure" (getf (aref errors 0) :message)))
      (is (= 1 (length recoveries)))
      (is (equal "Renderer recovered" (getf (aref recoveries 0) :description)))
      (is (= 1 (sgeo.render:renderer-frame-count renderer))))))

(test diagnostics-renderer-rethrows-uncaught-error
  (let ((profiler (sgeo.diagnostics:make-profiler))
        (renderer (make-instance 'diagnostics-fake-renderer :mode :signal)))
    (signals simple-error
      (sgeo.runtime::%with-profiled-frame (profiler "runtime-test")
        (sgeo.diagnostics:with-profile-scope ("render-test" :profiler profiler)
          (sgeo.render:render-frame renderer nil 64 64))))
    (let ((errors (getf (sgeo.diagnostics:profiler-snapshot profiler) :errors)))
      (is (= 1 (length errors)))
      (is (equal "uncaught fake backend failure" (getf (aref errors 0) :message)))
      (is (find "frame-end" (getf (sgeo.diagnostics:profiler-snapshot profiler) :timeline)
                :key (lambda (record) (getf record :kind)) :test #'equal)))
    (is (equal '(first second)
               (multiple-value-list
                (sgeo.runtime::%with-profiled-frame (profiler "multiple-values")
                  (values 'first 'second)))))))

(test diagnostics-delayed-gpu-query-keeps-original-frame
  (let* ((profiler (sgeo.diagnostics:make-profiler))
         (first-frame (sgeo.diagnostics:begin-frame profiler))
         (origin (getf (aref (getf (sgeo.diagnostics:profiler-snapshot profiler) :timeline) 0)
                       :timestamp-ns)))
    (sgeo.diagnostics:end-frame profiler first-frame)
    (sgeo.diagnostics:begin-frame profiler)
    (let ((gpu (sgeo.diagnostics:record-gpu-sample profiler "delayed" 1000 :frame first-frame))
          (counts (sgeo.diagnostics:record-pipeline-statistics profiler '(:triangles 12) :frame first-frame)))
      (is (= first-frame (getf gpu :frame)))
      (is (= origin (getf gpu :frame-host-start-ns)))
      (is (= origin (getf counts :frame-host-start-ns))))
    (is (member (getf (getf (sgeo.diagnostics:profiler-snapshot profiler) :capabilities) :allocation-scope)
                '("process" "unavailable") :test #'equal))))

(test diagnostics-nested-scopes-exceptions-and-frames
  (let* ((profiler (sgeo.diagnostics:make-profiler :timeline-limit 16))
         (frame (sgeo.diagnostics:begin-frame profiler "simulation")))
    (sgeo.diagnostics:with-profile-scope ("outer" :profiler profiler :subsystem "test"
                                        :object-class "Enemy")
      (sgeo.diagnostics:with-profile-scope ("inner" :subsystem "test" :function "inner-step")
        (make-string 128 :initial-element #\x)))
    (handler-case
        (sgeo.diagnostics:with-profile-scope ("failing" :profiler profiler :subsystem "test")
          (error "expected diagnostic test error"))
      (error (condition)
        (sgeo.diagnostics:record-diagnostic-error profiler condition :phase "simulation")))
    (sgeo.diagnostics:record-recovery profiler "continued after failure" :phase "simulation")
    (sgeo.diagnostics:end-frame profiler frame "simulation")
    (let* ((snapshot (sgeo.diagnostics:profiler-snapshot profiler))
           (aggregates (getf snapshot :aggregates))
           (outer (find "outer" aggregates :key (lambda (item) (getf item :function)) :test #'equal))
           (inner (find "inner-step" aggregates :key (lambda (item) (getf item :function)) :test #'equal))
           (text-report (sgeo.diagnostics:profile-report profiler :format :text)))
      (is (= 1 frame))
      (is (not (null outer)))
      (is (not (null inner)))
      (is (>= (getf outer :inclusive-ns) (getf outer :exclusive-ns)))
      (let ((scope (find "scope" (getf snapshot :timeline)
                         :key (lambda (item) (getf item :kind)) :test #'equal)))
        (is (numberp (getf scope :timestamp-ns)))
        (is (equal "host-monotonic" (getf scope :clock-origin))))
      (is (equal "simulation" (getf outer :frame-phase)))
      (is (equal "enemy" (getf outer :object-class)))
      (is (= 1 (length (getf snapshot :errors))))
      (is (= 1 (length (getf snapshot :recoveries))))
      (is (search "expected diagnostic test error" text-report))
      (is (search "continued after failure" text-report))
      (is (find "frame-end" (getf snapshot :timeline) :key (lambda (item) (getf item :kind)) :test #'equal)))))

(test diagnostics-thread-attribution-and-bounded-timeline
  (let ((profiler (sgeo.diagnostics:make-profiler :timeline-limit 3)))
    (let ((thread (bt:make-thread
                   (lambda ()
                     (sgeo.diagnostics:with-profile-scope ("worker" :profiler profiler)
                       (make-string 32 :initial-element #\w)))
                   :name "diagnostics-worker")))
      (bt:join-thread thread))
    (dotimes (index 5)
      (sgeo.diagnostics:record-recovery profiler (format nil "recovery ~D" index)))
    (let* ((snapshot (sgeo.diagnostics:profiler-snapshot profiler))
           (worker (find "worker" (getf snapshot :aggregates)
                         :key (lambda (item) (getf item :function)) :test #'equal)))
      (is (not (null worker)))
      (is (search "diagnostics-worker" (getf worker :thread)))
      (is (= 3 (length (getf snapshot :timeline)))))))

(test diagnostics-nested-collectors-keep-independent-exclusive-time
  (let ((outer-profiler (sgeo.diagnostics:make-profiler))
        (inner-profiler (sgeo.diagnostics:make-profiler)))
    (sgeo.diagnostics:with-profile-scope ("outer-collector" :profiler outer-profiler)
      (sleep 0.01)
      (sgeo.diagnostics:with-profile-scope ("inner-collector" :profiler inner-profiler)
        (sleep 0.02))
      (sleep 0.01))
    (let ((outer (aref (getf (sgeo.diagnostics:profiler-snapshot outer-profiler) :aggregates) 0))
          (inner (aref (getf (sgeo.diagnostics:profiler-snapshot inner-profiler) :aggregates) 0)))
      (is (>= (getf outer :exclusive-ns) 10000000))
      (is (>= (getf outer :inclusive-ns) (getf outer :exclusive-ns)))
      (is (>= (getf inner :inclusive-ns) 10000000)))))

(test diagnostics-phase-inheritance-and-cross-collector-exclusive-accounting
  (let ((outer-profiler (sgeo.diagnostics:make-profiler))
        (inner-profiler (sgeo.diagnostics:make-profiler)))
    (sgeo.diagnostics:with-profile-scope ("phase-parent" :profiler outer-profiler
                                         :frame-phase :simulation)
      (sleep 0.01)
      (sgeo.diagnostics:with-profile-scope ("foreign-collector" :profiler inner-profiler)
        (sleep 0.01)
        (sgeo.diagnostics:with-profile-scope ("same-collector-child" :profiler outer-profiler)
          (sleep 0.01)))
      (sleep 0.01))
    (let* ((aggregates (getf (sgeo.diagnostics:profiler-snapshot outer-profiler) :aggregates))
           (parent (find "phase-parent" aggregates :key (lambda (item) (getf item :function))
                         :test #'equal))
           (child (find "same-collector-child" aggregates
                        :key (lambda (item) (getf item :function)) :test #'equal)))
      (is (equal "simulation" (getf parent :frame-phase)))
      (is (equal "simulation" (getf child :frame-phase)))
      (is (>= (- (getf parent :inclusive-ns) (getf parent :exclusive-ns)) 5000000)))))

(test diagnostics-disabled-frame-apis-are-no-ops
  (let ((profiler (sgeo.diagnostics:make-profiler :enabled nil)))
    (is (null (sgeo.diagnostics:begin-frame profiler "disabled")))
    (is (null (sgeo.diagnostics:end-frame profiler)))
    (is (zerop (sgeo.diagnostics::profiler-frame profiler)))
    (is (zerop (length (getf (sgeo.diagnostics:profiler-snapshot profiler) :timeline))))))

(test diagnostics-allocation-capability-and-gpu-clock-origin
  (let ((profiler (sgeo.diagnostics:make-profiler)))
    (sgeo.diagnostics:with-profile-scope ("allocate" :profiler profiler)
      (dotimes (index 20) (declare (ignorable index)) (make-string 4096 :initial-element #\a)))
    (sgeo.diagnostics:record-gpu-sample profiler "opaque pass" 123456 :subsystem "renderer")
    (let* ((snapshot (sgeo.diagnostics:profiler-snapshot profiler))
           (scope (find "allocate" (getf snapshot :aggregates)
                        :key (lambda (item) (getf item :function)) :test #'equal))
           (gpu (find "gpu-sample" (getf snapshot :timeline)
                      :key (lambda (item) (getf item :kind)) :test #'equal)))
      (is (not (null scope)))
      (is (equal (if (sgeo.diagnostics:profiler-metrics-available-p profiler)
                     "available" "unavailable")
                 (getf (getf snapshot :capabilities) :allocation)))
      (when (sgeo.diagnostics:profiler-metrics-available-p profiler)
        (is (numberp (getf scope :allocated-bytes))))
      (is (not (null gpu)))
      (is (equal "gpu-query" (getf gpu :clock-origin)))
      (is (null (getf gpu :timestamp-ns)))
      (is (equal "unavailable" (getf (getf snapshot :capabilities) :gpu-pipeline-statistics)))
      (is (equal "available" (getf (getf snapshot :capabilities) :gpu))))))

(test diagnostics-pipeline-statistics-validation-and-json
  (let ((profiler (sgeo.diagnostics:make-profiler)))
    (sgeo.diagnostics:begin-frame profiler "render")
    (sgeo.diagnostics:record-pipeline-statistics
     profiler '(:vertices 120 :primitives 40 :vertex-shader-invocations 200)
     :frame 1 :subsystem "renderer" :backend "opengl")
    (let* ((snapshot (sgeo.diagnostics:profiler-snapshot profiler))
           (record (find "gpu-pipeline-statistics" (getf snapshot :timeline)
                         :key (lambda (item) (getf item :kind)) :test #'equal))
           (parsed (yason:parse (sgeo.diagnostics:profile-report profiler)))
           (chrome (yason:parse (sgeo.diagnostics:profile-report profiler :format :chrome-trace))))
      (is (not (null record)))
      (is (= 1 (getf record :frame)))
      (is (equal "gpu-query" (getf record :clock-origin)))
      (is (= 120 (gethash "vertices" (getf record :counters))))
      (is (equal "available"
                 (getf (getf snapshot :capabilities) :gpu-pipeline-statistics)))
      (is (hash-table-p parsed))
      (is (listp (gethash "traceEvents" chrome)))
      (is (plusp (length (gethash "traceEvents" chrome)))))
    (signals error
      (sgeo.diagnostics:record-pipeline-statistics profiler '(:bad -1)))))

(test diagnostics-simulation-phase-attribution
  (let* ((world (sgeo.scene:make-world))
         (state (sgeo.simulation:attach-simulation world))
         (profiler (sgeo.diagnostics:make-profiler)))
    (unwind-protect
         (sgeo.diagnostics:with-profile-scope ("world-frame" :profiler profiler)
           (sgeo.scene:advance-scene-frame world state (/ 1d0 60d0)))
      (sgeo.simulation:detach-simulation world))
    (let ((input (find "simulation/input" (getf (sgeo.diagnostics:profiler-snapshot profiler) :aggregates)
                       :key (lambda (entry) (getf entry :function)) :test #'equal)))
      (is (not (null input)))
      (is (equal "input" (getf input :frame-phase))))))

(test diagnostics-safe-json-and-detached-snapshots
  (let* ((renderer-data (make-hash-table :test #'equal))
         (cycle (make-hash-table :test #'equal)))
    (setf (gethash "backend" renderer-data) "headless"
          (gethash "cycle" cycle) cycle)
    (setf (gethash "unsafe-cycle" renderer-data) cycle)
    (let ((profiler (sgeo.diagnostics:make-profiler :renderer-info renderer-data)))
    (sgeo.diagnostics:record-recovery profiler "cycle-safe")
    (sgeo.diagnostics:with-profile-scope ("json" :profiler profiler)
      (values))
    (setf (gethash "backend" renderer-data) "mutated")
    (let* ((snapshot (sgeo.diagnostics:profiler-snapshot profiler))
           (report (sgeo.diagnostics:profile-report profiler))
           (parsed (yason:parse report)))
      (is (hash-table-p parsed))
      (is (search "unavailable" report))
      (is (equal "headless" (gethash "backend" (getf snapshot :renderer-info))))
      (is (search "[cycle]" report))
      (setf (getf (aref (getf snapshot :aggregates) 0) :calls) 99)
      (is (not (= 99 (getf (aref (getf (sgeo.diagnostics:profiler-snapshot profiler) :aggregates) 0)
                           :calls))))
      (sgeo.diagnostics:clear-profiler profiler)
      (is (zerop (length (getf (sgeo.diagnostics:profiler-snapshot profiler) :aggregates))))))))

(test diagnostics-json-encodes-explicit-false-metadata
  (let ((profiler (sgeo.diagnostics:make-profiler
                   :renderer-info '(:closed-p nil :validation nil :optional-value nil))))
    (let ((report (sgeo.diagnostics:profile-report profiler)))
      (is (search (if (member :single-threaded *features*)
                      "\"threaded\":false" "\"threaded\":true") report))
      (is (search "\"closed-p\":false" report))
      (is (search "\"validation\":false" report))
      (is (search "\"optional-value\":null" report)))))
