(in-package #:sgeo.tests)
(in-suite sgeo-suite)

(defun advanced-translated-box (x y z &optional (size 2d0))
  (let ((mesh (sg:make-half-edge-box :size size)))
    (sg:set-vertex-positions mesh
                            (mapcar (lambda (v) (cons v (sg:v+ (sg:vertex-position mesh v) (sg:make-vec3 x y z))))
                                    (sg:mesh-vertices mesh)))
    mesh))

(test advanced-public-facade-survives-optional-systems
  (dolist (name '("SUBDIVIDE-MESH" "CSG-UNION" "FIELD->MESH" "CURVE-POINT"
                  "MAKE-PROCEDURAL-OBJECT" "PROCESS-GEOMETRY" "INSET-FACE"))
    (multiple-value-bind (symbol status) (find-symbol name :sgeo)
      (is (eq :external status))
      (is (fboundp symbol)))))

(test advanced-subdivision-boundary-and-volume
  (let* ((box (sg:make-half-edge-box :size 2d0))
         (result (sg:subdivide-mesh box)))
    (is (sg:validate-mesh result))
    (is (= 26 (getf (sg:mesh-counts result) :vertices)))
    (is (= 24 (getf (sg:mesh-counts result) :faces)))
    (is (= 0 (getf (sg:mesh-counts result) :boundary-edges)))
    (is (< 0 (sg:mesh-volume result) (sg:mesh-volume box)))
    (let ((grid (sg:subdivide-mesh (sg:make-grid :columns 2 :rows 2))))
      (is (= 4 (length (sg:mesh-faces grid))))
      (is (= 1 (length (sg:boundary-loops grid))))
      (is (sg:validate-mesh grid)))
    (sg:triangulate-mesh box)
    (let ((loop-mesh (sg:subdivide-mesh box :scheme :loop)))
      (is (= 48 (length (sg:mesh-faces loop-mesh))))
      (is (sg:validate-mesh loop-mesh)))
    (signals sgeo.core:validation-error (sg:subdivide-mesh result :scheme :loop))
    (signals sgeo.core:validation-error (sg:subdivide-mesh box :levels -1))))

(test advanced-atomic-replacement-and-batch
  (let* ((mesh (sg:make-half-edge-box)) (vertex (first (sg:mesh-vertices mesh)))
         (revision (sg:object-revision mesh)) (position (sg:vertex-position mesh vertex)))
    (signals sg:geometry-error (sg:set-vertex-positions mesh (list (cons vertex position) (cons vertex position))))
    (is (= revision (sg:object-revision mesh)))
    (sg:set-vertex-positions mesh (mapcar (lambda (v) (cons v (sg:v+ (sg:vertex-position mesh v) (sg:make-vec3 1 2 3))))
                                        (sg:mesh-vertices mesh)))
    (is (= (1+ revision) (sg:object-revision mesh)))
    (is (vector-approximately= (sg:vertex-position mesh vertex) (sg:v+ position (sg:make-vec3 1 2 3))))
    (is (eq mesh (sg:subdivide-mesh mesh :in-place t)))
    (signals sg:stale-handle-error (sg:vertex-position mesh vertex))
    (is (sg:validate-mesh mesh))))

(test advanced-face-split-winding-components
  (let* ((mesh (sg:make-half-edge-box)) (face (first (sg:mesh-faces mesh)))
         (vs (sg:face-vertices mesh face)) (volume (sg:mesh-volume mesh)))
    (sg:split-face mesh face (first vs) (third vs))
    (is (= 7 (length (sg:mesh-faces mesh))))
    (is (approximately= volume (sg:mesh-volume mesh)))
    (signals sg:geometry-edit-error (sg:split-face mesh face (first vs) (second vs)))
    (sg:flip-winding mesh)
    (is (approximately= (- volume) (sg:mesh-volume mesh)))
    (is (= 1 (length (sg:extract-connected-components mesh))))
    (is (sg:validate-mesh mesh))))

(test advanced-boolean-boxes-and-empty-sets
  (let ((a (advanced-translated-box 0 0 0)) (b (advanced-translated-box 1 0 0)))
    (loop for operation in '(sg:csg-union sg:csg-intersection sg:csg-difference)
          for volume in '(12d0 4d0 4d0)
          do (let ((result (funcall operation a b)))
               (is (sg:validate-mesh result))
               (is (approximately= volume (sg:mesh-volume result)))
               (is (= 0 (getf (sg:mesh-counts result) :boundary-edges)))))
    (is (approximately= 8d0 (sg:mesh-volume (sg:csg-union a a))))
    (is (approximately= 8d0 (sg:mesh-volume (sg:csg-intersection a a))))
    (is (null (sg:csg-difference a a)))
    (is (null (sg:csg-intersection a (advanced-translated-box 5 0 0))))
    (is (approximately= 16d0 (sg:mesh-volume (sg:csg-union a (advanced-translated-box 5 0 0)))))
    (is (null (sg:csg-intersection nil a)))
    (signals sg:geometry-error (sg:csg-union (sg:make-grid) a))))

(test advanced-boolean-contained-touching-and-translated
  (let* ((a (advanced-translated-box 0 0 0 4d0))
         (b (advanced-translated-box 0 0 0 2d0))
         (cavity (sg:csg-difference a b)))
    (is (sg:validate-mesh cavity))
    (is (approximately= 56d0 (sg:mesh-volume cavity)))
    (is (approximately= 8d0 (sg:mesh-volume (sg:csg-intersection a b))))
    (is (approximately= 64d0 (sg:mesh-volume (sg:csg-union a b)))))
  (dolist (translation '(0d0 1000000000d0))
    (let* ((a (advanced-translated-box translation 0 0))
           (b (advanced-translated-box (+ translation 2d0) 0 0))
           (joined (sg:csg-union a b)))
      (is (sg:validate-mesh joined))
      (is (approximately= 16d0 (sg:mesh-volume joined)))
      (is (null (sg:csg-intersection a b))))))

(test advanced-boolean-empty-identities-validate-and-copy
  (let* ((source (sg:make-half-edge-box))
         (copy (sg:csg-union nil source)))
    (is (not (eq source copy)))
    (is (equalp (sg:mesh-polygon-data source) (sg:mesh-polygon-data copy)))
    (sg:subdivide-mesh copy :in-place t)
    (is (= 6 (length (sg:mesh-faces source))))
    (signals sg:geometry-error (sg:csg-union nil (sg:make-grid)))
    (signals sg:geometry-error (sg:csg-intersection nil (sg:make-grid)))
    (signals sg:geometry-error (sg:csg-difference source :invalid))
    (signals sg:geometry-error (sg:csg-union source nil :target :invalid))))
