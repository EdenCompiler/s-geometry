(in-package #:sgeo.tests)

(in-suite sgeo-suite)

(defun %robust-transform-mesh (mesh rotation &optional (translation (sgeo.math:make-vec3)))
  (sgeo.geometry:set-vertex-positions
   mesh (mapcar (lambda (vertex)
                 (cons vertex (sgeo.math:v+ translation
                                               (sgeo.math:transform-point rotation
                                                                          (sgeo.geometry:vertex-position mesh vertex)))))
               (sgeo.geometry:mesh-vertices mesh))))

(defun %robust-merge-solids (&rest meshes)
  (let ((positions (make-array 0 :adjustable t :fill-pointer 0)) (faces nil) (offset 0))
    (dolist (mesh meshes)
      (multiple-value-bind (mesh-positions mesh-faces) (sgeo.geometry:mesh-polygon-data mesh)
        (loop for position across mesh-positions do (vector-push-extend position positions))
        (dolist (face mesh-faces) (push (mapcar (lambda (index) (+ index offset)) face) faces))
        (incf offset (length mesh-positions))))
    (sgeo.geometry:make-half-edge-mesh :positions positions :faces (nreverse faces))))

(defun %concave-prism ()
  (let* ((outline #(#(0d0 0d0) #(3d0 0d0) #(3d0 1d0) #(1d0 1d0) #(1d0 3d0) #(0d0 3d0)))
         (count (length outline))
         (positions (make-array (* 2 count)))
         (faces nil))
    (dotimes (i count)
      (setf (aref positions i) (sgeo.math:make-vec3 (aref (aref outline i) 0) (aref (aref outline i) 1) 0d0)
            (aref positions (+ count i)) (sgeo.math:make-vec3 (aref (aref outline i) 0) (aref (aref outline i) 1) 2d0)))
    (push (reverse (loop for i below count collect i)) faces)
    (push (loop for i from count below (* 2 count) collect i) faces)
    (dotimes (i count)
      (let ((next (mod (1+ i) count)))
    (push (list i next (+ count next) (+ count i)) faces)))
    (sgeo.geometry:make-half-edge-mesh :positions positions :faces (nreverse faces))))

(test boolean-input-embedding-validates-cylinder-concave-and-nested-shells
  (let* ((cylinder (sgeo.geometry:make-cylinder :radius 0.8d0 :height 2d0 :segments 8))
         (prism (%concave-prism))
         (outer (sgeo.geometry:make-half-edge-box :size 4d0))
         (inner (sgeo.geometry:make-half-edge-box :size 2d0))
         (shell (sgeo.advanced:csg-difference outer inner)))
    (is (sgeo.advanced::%validate-solid-embedding cylinder))
    (is (sgeo.advanced::%validate-solid-embedding prism))
    (is (sgeo.advanced::%validate-solid-embedding shell))
    (let ((same-winding (%robust-merge-solids outer inner)))
      (signals sgeo.geometry:geometry-error
        (sgeo.advanced::%validate-solid-embedding same-winding)))))

(test boolean-input-embedding-exactly-allows-shared-topology-only
  (let* ((cube (sgeo.geometry:make-half-edge-box :size 2d0))
         (rotated (sgeo.geometry:make-half-edge-box :size 2d0)))
    (%robust-transform-mesh rotated (sgeo.math:rotation-y-mat4 0.37d0))
    (%robust-transform-mesh rotated (sgeo.math:rotation-x-mat4 -0.29d0))
    (%robust-transform-mesh rotated (sgeo.math:rotation-z-mat4 0.21d0)
                            (sgeo.math:make-vec3 0.7d0 0.2d0 0.1d0))
    (is (sgeo.advanced::%validate-solid-embedding cube))
    (is (sgeo.advanced::%validate-solid-embedding rotated))
    (let ((result (sgeo.advanced:csg-intersection cube rotated)))
      (is (sgeo.geometry:validate-mesh result))
      (is (= 0 (getf (sgeo.geometry:mesh-counts result) :boundary-edges)))
      (is (< 0d0 (sgeo.geometry:mesh-volume result)
             (min (sgeo.geometry:mesh-volume cube) (sgeo.geometry:mesh-volume rotated)))))
    (let ((touching-edge (sgeo.geometry:make-half-edge-box :size 2d0)))
      (%robust-transform-mesh touching-edge (sgeo.math:identity-mat4) (sgeo.math:make-vec3 2d0 2d0 0d0))
      (is (null (sgeo.advanced:csg-intersection cube touching-edge)))
      (let ((edge-union (sgeo.advanced:csg-union cube touching-edge)))
        (is (approximately= (+ (sgeo.geometry:mesh-volume cube) (sgeo.geometry:mesh-volume touching-edge))
                            (sgeo.geometry:mesh-volume edge-union)))
        (is (sgeo.advanced::%validate-solid-embedding edge-union))
        (let ((chained (sgeo.advanced:csg-intersection
                        edge-union (sgeo.geometry:make-half-edge-box :size 1d0))))
          (is (sgeo.advanced::%validate-solid-embedding chained))
          (is (approximately= 1d0 (sgeo.geometry:mesh-volume chained))))
        (let ((distant (sgeo.geometry:make-half-edge-box :size 2d0)))
          (%robust-transform-mesh distant (sgeo.math:identity-mat4) (sgeo.math:make-vec3 10d0 0d0 0d0))
          (let ((chained (sgeo.advanced:csg-union edge-union distant)))
            (is (sgeo.geometry:validate-mesh chained))
            (is (= 0 (getf (sgeo.geometry:mesh-counts chained) :boundary-edges)))
            (is (sgeo.advanced::%validate-solid-embedding chained))
            (is (approximately= 24d0 (sgeo.geometry:mesh-volume chained)))))))))

(test boolean-rotated-cylinders-concave-shells-and-containment-orientation
  (let* ((cylinder (sgeo.geometry:make-cylinder :radius 0.8d0 :height 2d0 :segments 8))
         (cube (sgeo.geometry:make-half-edge-box :size 1.8d0))
         (prism (%concave-prism)))
    (let* ((axis-cylinder (sgeo.geometry:make-cylinder :radius 0.8d0 :height 2d0 :segments 8))
           (axis-box (sgeo.geometry:make-half-edge-box :size 1.8d0))
           (cylinder-cut (sgeo.advanced:csg-intersection axis-cylinder axis-box)))
      (is (sgeo.geometry:validate-mesh cylinder-cut))
      (is (= 0 (getf (sgeo.geometry:mesh-counts cylinder-cut) :boundary-edges)))
      (is (< 0d0 (sgeo.geometry:mesh-volume cylinder-cut) (sgeo.geometry:mesh-volume axis-box))))
    (%robust-transform-mesh cylinder (sgeo.math:rotation-x-mat4 0.41d0)
                            (sgeo.math:make-vec3 0.25d0 0.1d0 0.2d0))
    (%robust-transform-mesh cube (sgeo.math:rotation-z-mat4 0.31d0))
    (is (sgeo.advanced::%validate-solid-embedding cylinder))
    (is (sgeo.advanced::%validate-solid-embedding prism))
    (let ((cut (sgeo.advanced:csg-difference prism cube)))
      (is (sgeo.geometry:validate-mesh cut))
      (is (sgeo.advanced::%validate-solid-embedding cut))
      (is (= 0 (getf (sgeo.geometry:mesh-counts cut) :boundary-edges))))
    (let* ((outer (sgeo.geometry:make-half-edge-box :size 4d0))
           (inner (sgeo.geometry:make-half-edge-box :size 2d0))
           (shell (sgeo.advanced:csg-difference outer inner)))
      (is (sgeo.advanced::%validate-solid-embedding shell))
      (is (approximately= 56d0 (sgeo.geometry:mesh-volume shell)))
      (let* ((same-winding-inner (sgeo.geometry:make-half-edge-box :size 2d0))
             (invalid (%robust-merge-solids outer same-winding-inner)))
        (signals sgeo.geometry:geometry-error (sgeo.advanced::%validate-solid-embedding invalid))))))

(test boolean-touching-points-near-coplanar-and-large-offset-metamorphic
  (let* ((base-a (sgeo.geometry:make-half-edge-box :size 2d0))
         (base-b (sgeo.geometry:make-half-edge-box :size 2d0)))
    (%robust-transform-mesh base-b (sgeo.math:identity-mat4) (sgeo.math:make-vec3 2d0 2d0 2d0))
    (is (null (sgeo.advanced:csg-intersection base-a base-b)))
    (let ((point-union (sgeo.advanced:csg-union base-a base-b)))
      (is (approximately= (+ (sgeo.geometry:mesh-volume base-a) (sgeo.geometry:mesh-volume base-b))
                          (sgeo.geometry:mesh-volume point-union)))
      (is (sgeo.advanced::%validate-solid-embedding point-union))
      (let ((chained (sgeo.advanced:csg-intersection
                      point-union (sgeo.geometry:make-half-edge-box :size 1d0))))
        (is (sgeo.advanced::%validate-solid-embedding chained))
        (is (approximately= 1d0 (sgeo.geometry:mesh-volume chained))))
      (let ((distant (sgeo.geometry:make-half-edge-box :size 2d0)))
        (%robust-transform-mesh distant (sgeo.math:identity-mat4) (sgeo.math:make-vec3 10d0 0d0 0d0))
        (let ((chained (sgeo.advanced:csg-union point-union distant)))
          (is (sgeo.advanced::%validate-solid-embedding chained))
          (is (approximately= 24d0 (sgeo.geometry:mesh-volume chained))))))
    (let ((reference-union nil) (reference-intersection nil))
    (dolist (offset '(0d0 1d9))
      (let* ((a (sgeo.geometry:make-half-edge-box :size 2d0))
             (b (sgeo.geometry:make-half-edge-box :size 2d0)))
        (%robust-transform-mesh a (sgeo.math:rotation-y-mat4 0.17d0) (sgeo.math:make-vec3 offset offset offset))
        (%robust-transform-mesh b (sgeo.math:rotation-y-mat4 0.17d0)
                                (sgeo.math:make-vec3 (+ offset 0.5d0) offset offset))
        (let ((union (sgeo.advanced:csg-union a b))
              (intersection (sgeo.advanced:csg-intersection a b)))
          (is (sgeo.advanced::%validate-solid-embedding union))
          (is (sgeo.advanced::%validate-solid-embedding intersection))
          (if (zerop offset)
              (setf reference-union (sgeo.geometry:mesh-volume union)
                    reference-intersection (sgeo.geometry:mesh-volume intersection))
              (progn
                (is (approximately= reference-union (sgeo.geometry:mesh-volume union) 1d-7))
                (is (approximately= reference-intersection (sgeo.geometry:mesh-volume intersection) 1d-7)))))))
    (let* ((a (sgeo.geometry:make-half-edge-box :size 2d0)) (b (sgeo.geometry:make-half-edge-box :size 2d0)))
      (%robust-transform-mesh b (sgeo.math:identity-mat4) (sgeo.math:make-vec3 0d0 0d0 1.999999d0))
      (let ((result (sgeo.advanced:csg-intersection a b)))
        (is (sgeo.advanced::%validate-solid-embedding result))
        (is (< 0d0 (sgeo.geometry:mesh-volume result) 8d0)))))))

(test boolean-invalid-embedding-rejects-before-atomic-target-replacement
  (let* ((a (sgeo.geometry:make-half-edge-box :size 2d0))
         (b (sgeo.geometry:make-half-edge-box :size 2d0))
         (crossing (%robust-merge-solids a b))
         (target (sgeo.geometry:make-half-edge-box))
         (revision (sgeo.core:object-revision target))
         (before (sgeo.geometry:mesh-volume target)))
    (%robust-transform-mesh b (sgeo.math:rotation-y-mat4 0.23d0) (sgeo.math:make-vec3 0.2d0 0.1d0 0d0))
    (setf crossing (%robust-merge-solids a b))
    (signals sgeo.geometry:geometry-error (sgeo.advanced::%validate-solid-embedding crossing))
    (signals sgeo.geometry:geometry-error (sgeo.advanced:csg-union crossing a :target target))
    (is (= revision (sgeo.core:object-revision target)))
    (is (approximately= before (sgeo.geometry:mesh-volume target)))
    (let ((point-touch (%robust-merge-solids a (%robust-transform-mesh (sgeo.geometry:make-half-edge-box :size 2d0)
                                                                       (sgeo.math:identity-mat4)
                                                                       (sgeo.math:make-vec3 2d0 2d0 2d0)))))
      (is (sgeo.advanced::%validate-solid-embedding point-touch)))
    (let ((face-touch (%robust-merge-solids a (%robust-transform-mesh (sgeo.geometry:make-half-edge-box :size 2d0)
                                                                       (sgeo.math:identity-mat4)
                                                                       (sgeo.math:make-vec3 2d0 0d0 0d0)))))
      (signals sgeo.geometry:geometry-error
        (sgeo.advanced::%validate-solid-embedding face-touch)))))
