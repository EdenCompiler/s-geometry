;;;; Verifica medições reais e limpeza das consultas; execute cada backend separadamente.
(load (merge-pathnames "bootstrap.lisp" (or *load-truename* *compile-file-truename*)))
(let ((backend (if (member "--vulkan" (uiop:command-line-arguments) :test #'equal) :vulkan :opengl)))
  (asdf:load-system (if (eq backend :vulkan) :sgeo/runtime/vulkan :sgeo/runtime))
  (asdf:load-system :sgeo/examples/simulation)
  (let ((profiler (uiop:symbol-call :sgeo.diagnostics :make-profiler :timeline-limit 10000))
        (world (uiop:symbol-call :sgeo.examples.simulation :make-game-world)))
    (unwind-protect
         (multiple-value-bind (returned renderer report)
             (uiop:symbol-call :sgeo.runtime :run-world world :backend backend :validation (eq backend :vulkan)
                               :max-frames 12 :visible nil :controls :game :repl nil :frame-dt (/ 1d0 60d0)
                               :profiler profiler)
           (declare (ignore returned))
           (let* ((snapshot (uiop:symbol-call :sgeo.diagnostics :profiler-snapshot profiler))
                  (timeline (getf snapshot :timeline))
                  (samples (remove-if-not (lambda (entry) (equal "gpu-sample" (getf entry :kind))) timeline))
                  (counts (remove-if-not (lambda (entry) (equal "gpu-pipeline-statistics" (getf entry :kind))) timeline)))
             (assert (null (uiop:symbol-call :sgeo.runtime :runtime-report-render-error report)))
             (assert (null (uiop:symbol-call :sgeo.runtime :runtime-report-platform-error report)))
             (assert (= 12 (uiop:symbol-call :sgeo.runtime :runtime-report-frames report)))
             (assert (plusp (length samples)))
             (assert (every (lambda (entry)
                              (and (numberp (getf entry :duration-ns)) (>= (getf entry :duration-ns) 0)
                                   (numberp (getf entry :frame-host-start-ns))
                                   (equal "gpu-query" (getf entry :clock-origin)))) samples))
             (assert (plusp (length counts)))
             (assert (some (lambda (entry)
                             (loop for value being the hash-values of (getf entry :counters)
                                   thereis (plusp value))) counts))
             (assert (find "frame-end" timeline :key (lambda (entry) (getf entry :kind)) :test #'equal))
             (assert (plusp (length (getf snapshot :aggregates))))
             (when (eq backend :vulkan)
               (assert (null (getf (getf snapshot :renderer-info) :validation-messages)))
               (assert (null (slot-value renderer (find-symbol "TIMESTAMP-QUERY-POOL" :sgeo.backend.vulkan))))
               (assert (null (slot-value renderer (find-symbol "PIPELINE-QUERY-POOL" :sgeo.backend.vulkan)))))
             (when (eq backend :opengl)
               (assert (null (slot-value renderer (find-symbol "PROFILE-QUERIES" :sgeo.backend.opengl)))))
             (uiop:symbol-call :sgeo.diagnostics :write-profile-report profiler
               (merge-pathnames (format nil "artifacts/m7-~(~A~)-profile.json" backend) *project-root*))
             (uiop:symbol-call :sgeo.diagnostics :write-profile-report profiler
               (merge-pathnames (format nil "artifacts/m7-~(~A~)-trace.json" backend) *project-root*) :format :chrome-trace)
             (format t "~&M7 ~A profiling: ~D GPU samples, ~D pipeline records; 12 frames; queries destroyed.~%"
                     backend (length samples) (length counts))))
      (uiop:symbol-call :sgeo.simulation :detach-simulation world :close-audio t))))
