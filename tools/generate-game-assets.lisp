;;;; Reconstrói fontes versionadas do exemplo; o build normal usa esses arquivos existentes.
(load (merge-pathnames "bootstrap.lisp" (or *load-truename* *compile-file-truename*)))
(asdf:load-system :sgeo/serialization)
(asdf:load-system :sgeo/audio)
(let* ((world (sgeo.scene:make-world))
       (geometry-path (merge-pathnames "assets/game/geometry.sgeo" *project-root*))
       (audio-path (merge-pathnames "assets/game/collect.pcm" *project-root*)))
  (dolist (spec (list (list "box" (sgeo.geometry:make-box :size 1d0))
                     (list "coin" (sgeo.geometry:make-sphere :radius 0.18d0 :segments 16 :rings 8))
                     (list "player" (sgeo.geometry:make-sphere :radius 0.35d0 :segments 16 :rings 8))))
    (sgeo.scene:add-to-world world (sgeo.scene:make-mesh-object (second spec) :name (first spec))))
  (ensure-directories-exist geometry-path)
  (sgeo.serialization:save-world world geometry-path)
  (ensure-directories-exist audio-path)
  (let ((samples (sgeo.audio:audio-buffer-samples (sgeo.audio:make-tone-buffer 880d0 0.09d0))))
    (with-open-file (stream audio-path :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
      (loop for sample across samples for word = (logand #xffff (round (* 32767 sample)))
            do (write-byte (ldb (byte 8 0) word) stream) (write-byte (ldb (byte 8 8) word) stream))))
  (format t "Game geometry and PCM sources written.~%"))
